    "batteryInformation": {
      "wltpRange": {
        "label": "Reichweite (WLTP)",
        "value": "427 km",
        "infoText": {
          "headline": "Reichweite",
          "text": "Die Reichweite eines Fahrzeugs mit vollständig geladener Batterie ist nur eine Schätzung. Die unter realen Bedingungen tatsächlich erzielbare Reichweite ist abhängig vom Fahrverhalten (Geschwindigkeit, Fahrzeugbeladung, Effizienz), den Wetter- und Straßenbedingungen, der verbleibenden Batteriekapazität und anderen Faktoren – und kann daher stark variieren."
        }
      },
      "warrantyInfo": {
        "label": "Verbleibende Garantie",
        "value": "Nicht angegeben",
        "infoText": {
          "headline": "Batterie-Garantie",
          "text": "Die Garantie für eine E-Fahrzeug-Batterie sichert dem Käufer in der Regel zu, dass die Leistungsfähigkeit der Batterie nicht zu stark abbaut. Entweder über einen festgelegten Zeitraum (meist 8 Jahre) oder eine bestimmte Laufleistung (meist zw. 100.000 - 160.000 km). Oft wird ein Wert von 70 bis 80 Prozent der ursprünglichen Kapazität zugesichert. Je nach Hersteller gibt es größere Unterschiede. Erkundige dich daher direkt beim Verkäufer nach den konkreten Garantiebedingungen."
        }
      },
      "batteryCapacity": {
        "label": "Batteriekapazität (in kWh)",
        "value": "67 kWh"
      },
      "chargingTimes": {
        "label": "Ladezeit",
        "fastDc": {
          "label": "Schnellladen (DC, max 300 kW)",
          "value": "32 Min.",
          "infoText": {
            "headline": "Öffentliches Laden (50 kW)",
            "text": "Die Schnellladezeit für Elektrofahrzeuge wird hauptsächlich durch die maximale Ladegeschwindigkeit bestimmt, die sowohl vom bordeigenen Ladegerät des Fahrzeugs als auch durch die Ladestation abhängt. Je höher die kW-Leistung beim Laden, desto schneller die Aufladung der Batterie und desto kürzer die Ladedauer.\n\nDie Ladezeit ist allerdings auch abhängig von anderen Faktoren: dem Ladezustand der Batterie (je leerer die Batterie, desto höher die Ladeleistung), der Außentemperatur und ob an der gleichen Ladesäule noch ein weiteres Fahrzeug lädt."
          }
        },
        "homeAc": {
          "label": "Zu Hause (AC, 11 kW)",
          "value": "-",
          "infoText": {
            "headline": "Aufladen zu Hause (11 kW)",
            "text": "Wer den nötigen Platz hat, kann sein Elektrofahrzeug bequem zu Hause aufladen. Notwendig ist nur ein Platz auf dem Grundstück – Garage, Carport, Einfahrt – und eine Wallbox.\n\nEine Wallbox erzeugt eine höhere Ladeleistung als eine Haushaltssteckdose und lädt das Fahrzeug deutlich schneller. Die Leistung reicht von ca. 4 kW bis 22 kW – je höher die Leistung, desto kürzer die Ladezeit."
          }
        }
      }
    },
