# AnnuncioForge — configurazione. Copia in `.env` (NON committare .env).

# --- Browser / scraping (S1) ---
# Profilo persistente: tiene cookie + consenso mobile.de tra i run (riduce blocchi).
BROWSER_PROFILE_DIR=./browser-profile
# true in produzione (consegna cliente). false la PRIMA volta per accettare consenso/captcha a mano.
PLAYWRIGHT_HEADLESS=true
# timeout navigazione in ms
NAV_TIMEOUT_MS=45000
# User-Agent (vuoto = default chromium). Impostare un UA desktop realistico se serve.
USER_AGENT=
# locale del browser
LOCALE=de-DE

# --- Prezzo (S4) — formula Max: esposto * (1 + PCT/100) + FIXED_1 + FIXED_2 ---
PRICE_SURCHARGE_PCT=3
PRICE_FIXED_1=1500
PRICE_FIXED_2=1500

# --- Licenza / abbonamento (kill-switch) ---
# URL di uno stato online che controlli TU (JSON pubblico: es. Gist GitHub "raw").
# L'app lo legge prima di ogni preventivo. Per SOSPENDERE un cliente: cambi il suo
# stato in "suspended" nel JSON e salvi → si blocca al link successivo.
# VUOTO = nessun controllo (l'app gira senza abbonamento forzato).
# Formato JSON:  {"novacar": "active"}   oppure   {"dealers": {"novacar": {"status": "active"}}}
LICENSE_URL=
