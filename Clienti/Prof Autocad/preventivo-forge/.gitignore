# segreti e config locale
.env
# profilo browser persistente (sessione/cookie mobile.de)
browser-profile/
.playwright/
# artefatti di run (transitori, locali): si versiona solo la cartella vuota
runs/*/
!runs/.gitkeep
# python
__pycache__/
*.pyc
*.pyo
# artefatti build App .exe (PyInstaller) — pesanti, non vanno in git
build/
dist/
*.exe
# log
logs/*.log
*.log
