# Copia questo file in .env e riempi i valori veri. Il .env NON va mai committato.

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- Gmail (mittente della consegna) ----------------------------------------
GMAIL_ADDRESS=tua@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Max

# --- Link di download, uno per prodotto -------------------------------------
# Il nome di queste variabili e' dichiarato in prodotti.json (campo "download_env").
# I link stanno SOLO qui, mai nel codice e mai nel catalogo.
EBOOK_DOWNLOAD_URL=https://.../48-leggi.pdf
MANUALE_CC_DOWNLOAD_URL=https://.../manuale-claude-code.pdf

# --- Fallback (facoltativo) -------------------------------------------------
# Cosa fare quando l'evento Stripe non dice quale prodotto e' stato comprato.
#   vuoto   -> usa il prodotto marcato "fallback": true in prodotti.json,
#              ma SOLO finche' nessun rail e' armato (nessun payment link /
#              price id nel catalogo). Appena ne armi uno, il fallback si spegne.
#   none    -> mai fallback: se non e' certo, non si consegna e si logga.
#   <chiave>-> forza un altro prodotto del catalogo come fallback.
FALLBACK_PRODUCT_KEY=

# --- Legacy -----------------------------------------------------------------
PDF_PATH=./ebook.pdf
