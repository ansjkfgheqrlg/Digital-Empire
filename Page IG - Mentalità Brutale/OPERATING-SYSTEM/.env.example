# Copy to .env in this directory. Never commit the real .env.
MB_META_API_VERSION=v25.0
MB_META_GRAPH_HOST=https://graph.instagram.com

# Meta Business Login for Instagram
MB_INSTAGRAM_APP_ID=
MB_INSTAGRAM_APP_SECRET=
MB_OAUTH_REDIRECT_URI=https://example.com/auth/instagram/callback
MB_IG_ACCESS_TOKEN=
MB_IG_USER_ID=

# Public HTTPS media mirror. The directory must be served at the base URL.
MB_PUBLIC_MEDIA_DIR=C:\path\outside-or-server-root\mentalita-media
MB_PUBLIC_MEDIA_BASE_URL=https://media.example.com/mentalita

# Safety interlock: keep NO until canary + certification are complete.
MB_LIVE_PUBLISH_ENABLED=NO
MB_REQUEST_TIMEOUT_SECONDS=45

# Optional local state override; *.sqlite is gitignored globally.
# MB_STATE_DB=C:\path\to\mb_os.sqlite
