{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocp.local/schemas/v1/workflow-command.json",
  "title": "CreateWorkflowCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "workflow_type", "goal", "constraints", "skill_input", "idempotency_key", "requested_by"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,64}$"},
    "workflow_type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 20000},
    "input_refs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 2048}},
    "risk_hint": {"enum": ["R0", "R1", "R2", "R3"]},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tasks", "deadline_seconds", "max_tokens", "max_cost_usd"],
      "properties": {
        "max_tasks": {"type": "integer", "minimum": 1, "maximum": 6},
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 200000},
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "skill_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_files", "artifact_path"],
      "properties": {
        "repository_files": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).{1,256}$"}},
        "artifact_path": {"type": "string", "pattern": "^adr/[A-Za-z0-9._/-]+\\.md$"}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
