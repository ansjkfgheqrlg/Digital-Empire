{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocp.local/schemas/v1/plan.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "workflow_id", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_id": {"type": "string", "format": "uuid"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role", "objective", "depends_on", "completion_criteria", "capabilities", "budget", "side_effect"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "role": {"enum": ["planner", "implementer", "critic", "gate", "compensator"]},
          "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "completion_criteria": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
          "capabilities": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]*(/\\*\\*)?$"}},
          "budget": {
            "type": "object", "additionalProperties": false,
            "required": ["max_tokens", "max_cost_usd", "timeout_seconds"],
            "properties": {
              "max_tokens": {"type": "integer", "minimum": 1, "maximum": 50000},
              "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 20},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
            }
          },
          "side_effect": {"$ref": "https://ocp.local/schemas/v1/side-effect-contract.json"}
        }
      }
    }
  }
}
