{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeReviewInput",
  "type": "object",
  "required": ["code_files"],
  "additionalProperties": false,
  "properties": {
    "code_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "artifact_path": {
      "type": "string",
      "default": "review/report.md"
    }
  }
}
