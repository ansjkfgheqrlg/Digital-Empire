{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocp.local/skills/repository-adr/input.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository_files", "artifact_path"],
  "properties": {
    "repository_files": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).{1,256}$"}
    },
    "artifact_path": {"type": "string", "pattern": "^adr/[A-Za-z0-9._/-]+\\.md$"}
  }
}
