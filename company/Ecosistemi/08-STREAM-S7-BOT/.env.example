# S7 Bot Environment Setup (PAPER TRADING)
# =======================================
# MAI INSERIRE LA CHIAVE PRIVATA REALE IN FASE DI TEST
# Questo file contiene solo nomi di variabili per scopi di documentazione.
# In produzione su VPS, esportare queste variabili direttamente nell'OS.

# Connessione RPC (Solana)
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Chiavi (SOLO PER PRODUZIONE, LASCIARE VUOTO QUI)
WALLET_PUBLIC_KEY=your_public_key_here
WALLET_PRIVATE_KEY=your_private_key_here

# Bot Settings
TRADE_MODE=SIMULATION  # [SIMULATION, LIVE]
MAX_POSITION_PCT=5     # Max 5% del bankroll per singola trade
BASE_BANKROLL_SOL=10.0 # Capitale simulato in partenza

# Webhook per Notifiche (Opzionale)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
