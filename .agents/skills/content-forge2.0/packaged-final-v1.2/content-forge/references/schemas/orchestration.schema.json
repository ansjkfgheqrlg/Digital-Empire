{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/orchestration.schema.json",
  "title": "Orchestration target output structure (v0.3 — Phase 9 tightened)",
  "type": "object",
  "schema_version": "0.3.0",
  "required": [
    "required_files",
    "preconditions",
    "routing_strategies"
  ],
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "routing.md",
        "registry.md",
        "registry.json",
        "policies.md",
        "observability.md",
        "failure_modes.md",
        "escalation.md",
        "eval_scenarios.json",
        "README.md"
      ]
    },
    "conditional_files": {
      "type": "object",
      "properties": {
        "supervisor.md": {
          "type": "string",
          "const": "required if strategy in [llm-based, hybrid]"
        }
      }
    },
    "preconditions": {
      "type": "object",
      "const": {
        "existing_components.json": "MUST be provided by user"
      }
    },
    "routing_strategies": {
      "type": "array",
      "const": [
        "rule-based",
        "llm-based",
        "hybrid"
      ]
    },
    "registry_components_min": {
      "const": 2,
      "description": "Orchestration con <2 componenti è un router semplice"
    },
    "registry_component_required_fields": {
      "type": "array",
      "const": [
        "slug",
        "type",
        "path",
        "owner",
        "description",
        "cost_class",
        "latency_class",
        "status"
      ]
    },
    "every_component_must_be_valid": {
      "const": true,
      "description": "FIX Phase 9: ogni componente nel registry deve essere un artifact valido (agent/skill/team/workflow)"
    },
    "routing_rules_min": {
      "const": 3,
      "description": "Almeno 3 rules"
    },
    "failure_modes_min": {
      "const": 5
    },
    "escalation_triggers_min": {
      "const": 2
    }
  },
  "additionalProperties": false
}