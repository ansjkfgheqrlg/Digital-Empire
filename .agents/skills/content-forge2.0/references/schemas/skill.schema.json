{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/skill.schema.json",
  "title": "Skill target output structure (v0.3 — Phase 9 tightened)",
  "description": "Forma canonica per skill prodotte da B4 + Stage 7. Bloccante se references < 3 o SKILL.md < 80 righe.",
  "type": "object",
  "schema_version": "0.3.0",
  "version_history": {
    "0.1.0-draft": "Phase 1",
    "0.2.0-draft": "Phase 2",
    "0.3.0": "Phase 9 — references_min_files=3 (FIX bug critico Test #2)"
  },
  "required": [
    "skill_md_max_lines",
    "skill_md_min_lines",
    "references_min_files",
    "evals_min_count",
    "frontmatter_required_keys",
    "description_min_chars",
    "description_max_chars",
    "description_pushy_markers_min"
  ],
  "properties": {
    "skill_md_max_lines": {
      "const": 500,
      "description": "Anthropic raccomandazione"
    },
    "skill_md_min_lines": {
      "const": 80,
      "description": "Sotto = scaffold inaccettabile"
    },
    "references_min_files": {
      "const": 3,
      "description": "FIX critico Phase 9: una skill con <3 reference è uno scaffold"
    },
    "references_min_total_lines": {
      "const": 300,
      "description": "300 righe totali = densità ragionevole"
    },
    "references_recommended_directories": {
      "type": "array",
      "const": [
        "concepts/",
        "stages/",
        "processes/",
        "patterns/",
        "conventions/",
        "schemas/"
      ],
      "description": "Una skill dovrebbe avere almeno 1-2 di queste"
    },
    "evals_min_count": {
      "const": 4
    },
    "evals_max_count_initial": {
      "const": 8,
      "description": "Senza assertions per il primo invio"
    },
    "frontmatter_required_keys": {
      "type": "array",
      "const": [
        "name",
        "description"
      ]
    },
    "description_min_chars": {
      "const": 800,
      "description": "Description troppo corta = no triggering"
    },
    "description_max_chars": {
      "const": 2500,
      "description": "Description troppo lunga = waste context"
    },
    "description_pushy_markers": {
      "type": "array",
      "const": [
        "make sure",
        "whenever",
        "even if",
        "always",
        "use this",
        "do not use"
      ]
    },
    "description_pushy_markers_min": {
      "const": 3,
      "description": "Almeno 3/6 marker per anti-undertriggering"
    },
    "optional_directories": {
      "type": "array",
      "const": [
        "agents",
        "scripts",
        "assets/templates",
        "assets/examples"
      ]
    },
    "agents_directory_recommended_if": {
      "type": "string",
      "const": "skill performs multi-step workflow with distinct cognitive roles"
    },
    "scripts_directory_recommended_if": {
      "type": "string",
      "const": "skill has deterministic operations (parsing, validation, packaging)"
    }
  },
  "additionalProperties": false
}