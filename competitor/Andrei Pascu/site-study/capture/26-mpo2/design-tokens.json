 "headings": [
  {
   "tag": "h1",
   "y": 238,
   "text": "Ti insegnerò il mindset che ho usato per costruire un’agenzia di marketing a 6 cifre"
  },
  {
   "tag": "h2",
   "y": 1019,
   "text": "Non “basta crederci” per avere successo"
  },
  {
   "tag": "h2",
   "y": 1612,
   "text": "Avere Mindset non significa guardare video motivazionali"
  },
  {
   "tag": "h2",
   "y": 2391,
   "text": "Perché non stai raggiungendo i tuoi risultati?"
  },
  {
   "tag": "h2",
   "y": 3486,
   "text": "Il mindset si impara, e io voglio insegnarlo a te"
  },
  {
   "tag": "h2",
   "y": 4007,
   "text": "Vali più di quello che pensi"
  },
  {
   "tag": "h2",
   "y": 4624,
   "text": "Il vero motivo per cui non sei dove vorresti essere"
  },
  {
   "tag": "h1",
   "y": 5586,
   "text": "Argomenti trattati nel percorso"
  },
  {
   "tag": "h2",
   "y": 6904,
   "text": "Ecco i pareri di alcuni studenti della prima versione di Mindset: Programma Operativo"
  },
  {
   "tag": "h1",
   "y": 7629,
   "text": "Tutto ciò che ti serve"
  },
  {
   "tag": "h2",
   "y": 8611,
   "text": "Domande comuni"
  }
 ],
