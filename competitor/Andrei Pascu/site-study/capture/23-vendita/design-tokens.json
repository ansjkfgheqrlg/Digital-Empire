 "headings": [
  {
   "tag": "h1",
   "y": 194,
   "text": "Impara come vendere quello che ti pare a chi ti pare."
  },
  {
   "tag": "h3",
   "y": 399,
   "text": "Ti insegno io come si fa."
  },
  {
   "tag": "h1",
   "y": 945,
   "text": "La verità sulla vendita."
  },
  {
   "tag": "h2",
   "y": 1555,
   "text": "Le 3 categorie di persone che devono saper vendere:"
  },
  {
   "tag": "h2",
   "y": 2097,
   "text": "I problemi con la formazione classica"
  },
  {
   "tag": "h2",
   "y": 3471,
   "text": "In Vendita101 imparerai la scienza che c’è dietro la vendita"
  },
  {
   "tag": "h3",
   "y": 4040,
   "text": "Sono riuscito a diventare chi sono grazie alla scienza della comunicazione."
  },
  {
   "tag": "h2",
   "y": 4457,
   "text": "Niente chiacchiere: solo fatti e strategie (vedi l’anteprima)"
  },
  {
   "tag": "h2",
   "y": 5258,
   "text": "La vendita è cambiata. Non mi credi? Chiedilo ai miei partner"
  },
  {
   "tag": "h3",
   "y": 5748,
   "text": "Stefano De Cubellis"
  },
  {
   "tag": "h3",
   "y": 5748,
   "text": "Roberto Fiori Rocco"
  },
  {
   "tag": "h3",
   "y": 5748,
   "text": "Manuel Bollino"
  },
  {
   "tag": "h3",
   "y": 5748,
   "text": "Hafid El Amrani"
  },
  {
   "tag": "h1",
   "y": 6925,
   "text": "Vendita nei film ≠ Vendita nella vita reale"
  },
  {
   "tag": "h3",
   "y": 7094,
   "text": "La mia “traumatica” esperienza con la vendita"
  },
  {
   "tag": "h3",
   "y": 7558,
   "text": "Hai presente il “cazzo, non so che dire”?"
  },
  {
   "tag": "h3",
   "y": 8257,
   "text": "Fare il venditore significa essere il rompi-pa**e che non sa farsi dire di no?"
  },
  {
   "tag": "h2",
   "y": 9007,
   "text": "Lo script ti fa sembrare la tipa della Vodafone che vuole vendermi l’offerta “SpeCiAlE soLO PeR Me”"
  },
  {
   "tag": "h2",
   "y": 9708,
   "text": "E quindi è il momento di vendere per davvero."
  },
  {
   "tag": "h1",
   "y": 10214,
   "text": "Cosa Vendita101 può fare per te:"
  },
  {
   "tag": "h1",
   "y": 10986,
   "text": "Cosa imparerai?"
  },
  {
   "tag": "h2",
   "y": 11597,
   "text": "Tutto ciò che devi sapere per imparare la skill."
  },
  {
   "tag": "h2",
   "y": 12486,
   "text": "Quindi, hai deciso di non entrare?"
  },
  {
   "tag": "h2",
   "y": 13616,
   "text": "Alcune recensioni lasciate dagli studenti di Vendita101"
  }
 ],
