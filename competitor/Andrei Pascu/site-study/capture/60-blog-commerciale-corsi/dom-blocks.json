 {
  "tag": "p",
  "y": 8093,
  "x": 446,
  "w": 547,
  "text": "Peer-to-peer: informale, diretto, pratico. \"Tu\", mai \"Lei\". Niente accademismo, niente misticismo, niente complessità inutile. I concetti vanno semplificati fino al meccanismo reale che li fa funzionare.",
  "inline": [],
  "color": "#fafafa",
  "size": 16,
  "weight": "300",
  "transform": "none",
  "align": "start",
  "href": null
 },
