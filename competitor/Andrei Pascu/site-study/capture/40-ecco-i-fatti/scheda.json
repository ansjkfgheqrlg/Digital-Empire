 "headings": [
  {
   "tag": "h2",
   "y": 149,
   "text": "Scopri perché sempre più persone ambiziose trovano la loro strada ed indipendenza economica grazie al Copywriting."
  },
  {
   "tag": "h3",
   "y": 1724,
   "text": "Il 60,4% delle aziende italiane fattura meno di 100mila euro l’anno… Mentre lo 0,21% fattura +50 MILIONI di euro (fonte)"
  },
  {
   "tag": "h3",
   "y": 2338,
   "text": "Lo strumento per aumentare fatturati? Il marketing."
  },
  {
   "tag": "h1",
   "y": 4151,
   "text": "In 5 minuti ti spiego perché il copywriting è il migliore modello di business per iniziare"
  },
  {
   "tag": "h2",
   "y": 4966,
   "text": "Gli esperti del digital marketing sono tra le professioni più ricercate per il 2024 (fonte)"
  },
  {
   "tag": "h1",
   "y": 5992,
   "text": "Google rivela come il copywriting stia diventando più popolare che mai"
  },
  {
   "tag": "h2",
   "y": 7234,
   "text": "Chiunque, se lo vuole, può fare copywriting."
  },
  {
   "tag": "h2",
   "y": 8707,
   "text": "Ma com'è possibile che le aziende paghino così tanto per delle frasi scritte su un foglio?"
  },
  {
   "tag": "h2",
   "y": 9995,
   "text": "Okay, ma chi sono io per parlarti di Copywriting?"
  },
  {
   "tag": "h2",
   "y": 10959,
   "text": "Quale è il problema con (quasi) tutti i percorsi di formazione sul Copywriting?"
  },
  {
   "tag": "h3",
   "y": 11493,
   "text": "Poi ci sono altri percorsi online di altre persone…"
  },
  {
   "tag": "h3",
   "y": 12660,
   "text": "Copywriting Mentorship è il primo corso italiano di copywriting che ti segue passo-passo fino a trovare il primo cliente."
  },
  {
   "tag": "h3",
   "y": 13356,
   "text": "Conosco quel sentimento"
  },
  {
   "tag": "h2",
   "y": 14074,
   "text": "Copywriting Mentorship a confronto con altri percorsi"
  },
  {
   "tag": "h2",
   "y": 14935,
   "text": "Quale è la conclusione?"
  }
 ],
