 "headings": [
  {
   "tag": "h1",
   "text": "Automatizziamo la tua operatività con AI Workflows."
  },
  {
   "tag": "h2",
   "text": "Tre sistemi. Un'unica operatività che gira da sola."
  },
  {
   "tag": "h2",
   "text": "AUTOMAZIONE AI PROPRIETARIA = più tempo, più margine."
  },
  {
   "tag": "h3",
   "text": "SETUP COMPLETO"
  },
  {
   "tag": "h3",
   "text": "EMAIL AL GIORNO"
  },
  {
   "tag": "h3",
   "text": "CANONI MENSILI"
  },
  {
   "tag": "h2",
   "text": "Ideato su misura per Creator, Coach & Business Owner."
  },
  {
   "tag": "h2",
   "text": "Il problema non è “non avere tempo”. È fare a mano ciò che un sistema AI fa da solo."
  },
  {
   "tag": "h3",
   "text": "L'operatività manuale"
  },
  {
   "tag": "h3",
   "text": "Con un sistema AI proprietario"
  },
  {
   "tag": "h2",
   "text": "La tua giornata assomiglia a questa?"
  },
  {
   "tag": "h2",
   "text": "Mentre leggi questa pagina, un tuo competitor sta automatizzando."
  },
  {
   "tag": "h2",
   "text": "ASCOLTA BENE."
  },
  {
   "tag": "h2",
   "text": "In quale livello sei oggi? E dove vuoi essere domani?"
  },
  {
   "tag": "h3",
   "text": "Operatività Manuale"
  },
  {
   "tag": "h3",
   "text": "SaaS di Terze Parti"
  },
  {
   "tag": "h3",
   "text": "Sistema AI Proprietario"
  },
  {
   "tag": "h2",
   "text": "Perché Digital Empire?"
  },
  {
   "tag": "h3",
   "text": "Proprietà totale. Zero dipendenze."
  },
  {
   "tag": "h3",
   "text": "Un problema. Una soluzione precisa."
  },
  {
   "tag": "h3",
   "text": "Setup in 7 giorni. Poi gira da solo."
  },
  {
   "tag": "h2",
   "text": "Framework F.L.O.W."
  },
  {
   "tag": "h3",
   "text": "Flusso. Mappiamo tutto."
  },
  {
   "tag": "h3",
   "text": "Logica. Progettiamo il sistema."
  },
  {
   "tag": "h3",
   "text": "Output. Costruiamo e testiamo."
  },
  {
   "tag": "h3",
   "text": "Watch. Monitoriamo e ottimizziamo."
  },
  {
   "tag": "h2",
   "text": "Ogni sistema, nel dettaglio."
  },
  {
   "tag": "h2",
   "text": "Outreach automatico su Gmail e Social."
  },
  {
   "tag": "h2",
   "text": "Cosa include la tua piattaforma di Outreach."
  },
  {
   "tag": "h3",
   "text": "Core Automation Engine"
  },
  {
   "tag": "h3",
   "text": "Proxy & Account Setup"
  },
  {
   "tag": "h3",
   "text": "Dashboard UI & CRM"
  },
  {
   "tag": "h2",
   "text": "Fabbrica di Contenuti social su pilota automatico."
  },
  {
   "tag": "h2",
   "text": "Cosa produce la tua fabbrica di contenuti."
  },
  {
   "tag": "h3",
   "text": "Caroselli Instagram"
  },
  {
   "tag": "h3",
   "text": "Script Video AI"
  },
  {
   "tag": "h3",
   "text": "Caption + Hashtag"
  },
  {
   "tag": "h3",
   "text": "Upload Google Drive"
  },
  {
   "tag": "h3",
   "text": "Pubblicazione Programmata"
  },
  {
   "tag": "h3",
   "text": "Batch Produzione Multipla"
  },
  {
   "tag": "h2",
   "text": "Second Brain: l'AI non dimentica più."
  },
  {
   "tag": "h2",
   "text": "Cosa include il tuo Second Brain."
  },
  {
   "tag": "h3",
   "text": "Knowledge Base a Grafo"
  },
  {
   "tag": "h3",
   "text": "Integrazione LLM Avanzata"
  },
  {
   "tag": "h3",
   "text": "Workflow di Aggiornamento"
  },
  {
   "tag": "h2",
   "text": "Fatti, non slogan."
  },
  {
   "tag": "h3",
   "text": "Codice sorgente consegnato"
  },
  {
   "tag": "h3",
   "text": "90 giorni di supporto dedicato"
  },
  {
   "tag": "h3",
   "text": "Garanzia 30 giorni"
  },
  {
   "tag": "h3",
   "text": "Setup in 7 giorni"
  },
  {
   "tag": "h3",
   "text": "Zero canoni mensili"
  },
  {
   "tag": "h3",
   "text": "Vuoi vederlo dal vivo?"
  },
  {
   "tag": "h2",
   "text": "Non vendiamo abbonamenti. Vendiamo asset."
  },
  {
   "tag": "h2",
   "text": "Non stai scegliendo noi contro un'altra agenzia. Stai scegliendo tra quattro strade."
  },
  {
   "tag": "h2",
   "text": "Facciamo tre cose. Queste cinque no."
  },
  {
   "tag": "h2",
   "text": "Niente black box. Ogni tool spiegato e consegnato."
  },
  {
   "tag": "h3",
   "text": "CLAUDE AI"
  },
  {
   "tag": "h3",
   "text": "GMAIL API"
  },
  {
   "tag": "h3",
   "text": "PLAYWRIGHT"
  },
  {
   "tag": "h3",
   "text": "PROXY RESIDENZIALI"
  },
  {
   "tag": "h3",
   "text": "APSOC FRAMEWORK"
  },
  {
   "tag": "h3",
   "text": "N8N"
  },
  {
   "tag": "h3",
   "text": "OPENAI API"
  },
  {
   "tag": "h3",
   "text": "SUPABASE"
  },
  {
   "tag": "h3",
   "text": "GOOGLE DRIVE"
  },
  {
   "tag": "h3",
   "text": "SLACK / CRM"
  },
  {
   "tag": "h3",
   "text": "REACT / NEXT.JS"
  },
  {
   "tag": "h3",
   "text": "OBSIDIAN / NOTION"
  },
  {
   "tag": "h2",
   "text": "Non solo il sistema. L'infrastruttura completa."
  },
  {
   "tag": "h3",
   "text": "Il sistema AI completo"
  },
  {
   "tag": "h3",
   "text": "Pannello di controllo custom"
  },
  {
   "tag": "h3",
   "text": "Configurazione proxy residenziali"
  },
  {
   "tag": "h3",
   "text": "APSOC Framework calibrato"
  },
  {
   "tag": "h3",
   "text": "Integrazione Slack / CRM"
  },
  {
   "tag": "h3",
   "text": "90 giorni di supporto dedicato"
  },
  {
   "tag": "h2",
   "text": "“Ok ma chi siete?”"
  },
  {
   "tag": "h2",
   "text": "Prendo quello che uso io ogni singolo giorno e lo adatto a te."
  },
  {
   "tag": "h2",
   "text": "Non solo il codice. L'infrastruttura pronta a girare da sola."
  },
  {
   "tag": "h3",
   "text": "Configurazione proxy residenziali"
  },
  {
   "tag": "h3",
   "text": "Integrazione Slack / CRM"
  },
  {
   "tag": "h3",
   "text": "Supporto tecnico dedicato"
  },
  {
   "tag": "h3",
   "text": "Formazione team inclusa"
  },
  {
   "tag": "h2",
   "text": "“Automatizzare” non è una parola. È una divisione."
  },
  {
   "tag": "h2",
   "text": "Un sistema AI proprietario. Un asset permanente."
  },
  {
   "tag": "h3",
   "text": "Outreach Factory"
  },
  {
   "tag": "h3",
   "text": "Second Brain"
  },
  {
   "tag": "h3",
   "text": "Content Factory"
  },
  {
   "tag": "h3",
   "text": "Engine Room"
  },
  {
   "tag": "h3",
   "text": "La matematica"
  },
  {
   "tag": "h2",
   "text": "Ti serviamo in tre momenti. Negli altri, no."
  },
  {
   "tag": "h2",
   "text": "Cosa succede esattamente dopo la chiamata."
  },
  {
   "tag": "h3",
   "text": "Chiamata Strategica gratuita"
  },
  {
   "tag": "h3",
   "text": "Proposta Tecnica personalizzata"
  },
  {
   "tag": "h3",
   "text": "Contratto & onboarding"
  },
  {
   "tag": "h3",
   "text": "Setup & installazione completa"
  },
  {
   "tag": "h3",
   "text": "Calibrazione & go-live"
  },
  {
   "tag": "h3",
   "text": "Supporto tecnico dedicato"
  },
  {
   "tag": "h2",
   "text": "Se il sistema non funziona come promesso, lo sistemiamo."
  },
  {
   "tag": "h2",
   "text": "Le 4 obiezioni che demoliamo prima di iniziare."
  },
  {
   "tag": "h3",
   "text": "“ChatGPT fa già tutto questo, gratis.”"
  },
  {
   "tag": "h3",
   "text": "“Ma Instagram mi banna se automatizzo.”"
  },
  {
   "tag": "h3",
   "text": "“Il copy generato dall’AI sembra robotico.”"
  },
  {
   "tag": "h3",
   "text": "“Diventerei dipendente da voi per sempre.”"
  },
  {
   "tag": "h2",
   "text": "Domande frequenti."
  },
  {
   "tag": "h3",
   "text": "In quanto tempo il sistema è operativo?"
  },
  {
   "tag": "h3",
   "text": "Ho bisogno di un server dedicato?"
  },
  {
   "tag": "h3",
   "text": "Cosa succede se Instagram cambia qualcosa?"
  },
  {
   "tag": "h3",
   "text": "Posso acquistare un solo sistema invece di tutti e tre?"
  },
  {
   "tag": "h3",
   "text": "C'è una garanzia?"
  },
  {
   "tag": "h3",
   "text": "Continui come prima"
  },
  {
   "tag": "h3",
   "text": "Implementi il sistema"
  },
  {
   "tag": "h2",
   "text": "Pronto a far lavorare il sistema per te?"
  },
  {
   "tag": "h3",
   "text": "AI Proprietaria"
  },
  {
   "tag": "h2",
   "text": "Noi siamo Digital Empire."
  },
  {
   "tag": "h2",
   "text": "Sei anni fa ero un ragazzo ossessionato da Internet."
  },
  {
   "tag": "h2",
   "text": "Poi un giorno ho deciso di non lavorare più da solo."
  },
  {
   "tag": "h2",
   "text": "Tre persone. Zero filtri tra te e chi costruisce."
  },
  {
   "tag": "h3",
   "text": "Maximilian"
  },
  {
   "tag": "h3",
   "text": "Gael"
  },
  {
   "tag": "h3",
   "text": "Leonardo"
  },
  {
   "tag": "h2",
   "text": "Installiamo sistemi AI che lavorano mentre dormi."
  },
  {
   "tag": "h3",
   "text": "Outreach Factory"
  },
  {
   "tag": "h3",
   "text": "Content Factory"
  },
  {
   "tag": "h3",
   "text": "Second Brain"
  },
  {
   "tag": "h2",
   "text": "Vuoi entrare in Empire?"
  }
