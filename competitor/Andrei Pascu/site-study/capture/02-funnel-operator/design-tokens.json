 "headings": [
  {
   "tag": "h2",
   "text": "Funnel Operator: l’evoluzione del full stack marketer. Fai CRO per aziende copiando la carriera di Andrei Pascu."
  },
  {
   "tag": "h2",
   "text": "Le aziende lo vogliono, non lo trovano e son disposte a pagare tanto per averlo."
  },
  {
   "tag": "h3",
   "text": "Sto per parlarti di soldi, guadagno e una intera carriera. Non posso parlartene bene se prima non mi conosci."
  },
  {
   "tag": "h2",
   "text": "Piacere, sono Andrei c:"
  },
  {
   "tag": "h2",
   "text": "Ero confuso e (onestamente…) un po’ sfigato"
  },
  {
   "tag": "h2",
   "text": "2020"
  },
  {
   "tag": "h3",
   "text": "Primi clienti chiusi."
  },
  {
   "tag": "h2",
   "text": "2021"
  },
  {
   "tag": "h3",
   "text": "Avevo 19 anni. E mi trasferisco a Bologna da solo."
  },
  {
   "tag": "h2",
   "text": "2021 - oggi"
  },
  {
   "tag": "h3",
   "text": "Non sono più SOLO!!! Finalmente assumo un team."
  },
  {
   "tag": "h2",
   "text": "inizio 2025"
  },
  {
   "tag": "h3",
   "text": "Ti auguro lo stesso problema 😅"
  },
  {
   "tag": "h1",
   "text": "Cos’è CRO e come funziona?"
  },
  {
   "tag": "h3",
   "text": "CRO = migliorare il marketing. Renderlo più convincente."
  },
  {
   "tag": "h1",
   "text": "Perché il CRO (chiamato anche Funnel Operator) paga bene?"
  },
  {
   "tag": "h1",
   "text": "Funnel Operator, il marketer che le aziende vogliono nel 2026"
  },
  {
   "tag": "h1",
   "text": "Il Funnel Operator si fa pagare per:"
  },
  {
   "tag": "h2",
   "text": "Quindi, per fare il funnel operator, devi:"
  },
  {
   "tag": "h1",
   "text": "La realtà dei fatti?"
  },
  {
   "tag": "h3",
   "text": "E lo afferma anche questo studio:"
  },
  {
   "tag": "h3",
   "text": "Ho fatto 28 test di 28 servizi diversi. Solo Funnel Operator è sopravvissuto."
  },
  {
   "tag": "h3",
   "text": "Gli altri ti mettono 30 video-recensioni (sicuramente tutte realissime e non pagate 💀💀). Io ti mostro i dati."
  },
  {
   "tag": "h3",
   "text": "Ho scelto il copywriting dato che funziona anche durante i periodi di peggiore crisi:"
  },
  {
   "tag": "h2",
   "text": "Per chi ho creato Funnel Operator"
  },
  {
   "tag": "h2",
   "text": "Domande comuni"
  }
 ],
