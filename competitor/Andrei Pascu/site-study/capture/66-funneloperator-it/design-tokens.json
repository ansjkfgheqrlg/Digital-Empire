 "headings": [
  {
   "tag": "h1",
   "y": 161,
   "text": "Un giorno morirai."
  },
  {
   "tag": "h2",
   "y": 1499,
   "text": "Diventa funnel operator oggi"
  },
  {
   "tag": "h2",
   "y": 4436,
   "text": "La realtà dei fatti?"
  },
  {
   "tag": "h3",
   "y": 5145,
   "text": "L'evoluzione del copywriting"
  },
  {
   "tag": "h3",
   "y": 5403,
   "text": "Apri i 3 siti che hai visitato oggi."
  },
  {
   "tag": "h2",
   "y": 6284,
   "text": "Come funziona"
  },
  {
   "tag": "h2",
   "y": 7976,
   "text": "Fare siti Fare landing pages."
  },
  {
   "tag": "h2",
   "y": 8945,
   "text": "Perché fare landing pages è il servizio che ho scelto"
  },
  {
   "tag": "h2",
   "y": 9847,
   "text": "Titolare AP Sales"
  },
  {
   "tag": "h2",
   "y": 10923,
   "text": "Esempi di pagine fatte da"
  },
  {
   "tag": "h2",
   "y": 11857,
   "text": "Per chi ho creato Funnel Operator:"
  },
  {
   "tag": "h2",
   "y": 12637,
   "text": "“Ma chi cazzo pensi di essere?”"
  },
  {
   "tag": "h2",
   "y": 14561,
   "text": "LA CRISI DEL 2025"
  },
  {
   "tag": "h2",
   "y": 15164,
   "text": "Ho fatto 28 test di 28 servizi diversi. È sopravvissuto solo uno."
  },
  {
   "tag": "h2",
   "y": 16510,
   "text": "Schiavizzerai l'AI."
  },
  {
   "tag": "h2",
   "y": 17136,
   "text": "L'AI ti ruba il lavoro. Ruberai il lavoro a chi non sa usare l'AI."
  },
  {
   "tag": "h3",
   "y": 17633,
   "text": "Ci sono 2 tipi di persone che usano l'AI per fare pagine:"
  },
  {
   "tag": "h2",
   "y": 18390,
   "text": "«Non è un business sexy… Ma funziona»"
  },
  {
   "tag": "h3",
   "y": 19481,
   "text": "Impara a fare landing page"
  },
  {
   "tag": "h3",
   "y": 19481,
   "text": "Impara a trovare clienti"
  },
  {
   "tag": "h3",
   "y": 19481,
   "text": "Chiudi un caso studio"
  },
  {
   "tag": "h3",
   "y": 19481,
   "text": "Fatti pagare"
  },
  {
   "tag": "h2",
   "y": 20048,
   "text": "FUNNEL OPERATOR"
  },
  {
   "tag": "h2",
   "y": 22082,
   "text": "Il corso copre quasi ogni possibilità."
  },
  {
   "tag": "h3",
   "y": 22968,
   "text": "Dove si fa la consulenza?"
  },
  {
   "tag": "h3",
   "y": 23049,
   "text": "Come si fissa?"
  },
  {
   "tag": "h3",
   "y": 23130,
   "text": "A cosa serve?"
  },
  {
   "tag": "h3",
   "y": 23211,
   "text": "Perché devo fare 50 contatti e finire il corso per fare call?"
  },
  {
   "tag": "h2",
   "y": 23505,
   "text": "Asset pronti per te"
  },
  {
   "tag": "h2",
   "y": 24741,
   "text": "Prima pagina online entro 24h"
  },
  {
   "tag": "h2",
   "y": 25654,
   "text": "Community su Telegram"
  },
  {
   "tag": "h2",
   "y": 26421,
   "text": "Troverai veramente clienti?"
  },
  {
   "tag": "h3",
   "y": 26686,
   "text": "Per 10 mesi abbiamo testato metodi per trovare clienti con AP Sales"
  },
  {
   "tag": "h3",
   "y": 28060,
   "text": "Ti diamo materiale di vendita"
  },
  {
   "tag": "h2",
   "y": 28722,
   "text": "Registrazioni chiamate di vendita di AP Sales"
  },
  {
   "tag": "h3",
   "y": 29420,
   "text": "«Se questo metodo funziona così bene, perché lo insegni?»"
  },
  {
   "tag": "h3",
   "y": 29627,
   "text": "«Ma così non ti crei concorrenza da solo?»"
  },
  {
   "tag": "h3",
   "y": 29844,
   "text": "«Se guadagni con le landing pages, perché vendi anche corsi?»"
  },
  {
   "tag": "h2",
   "y": 30195,
   "text": "Questo percorso lo descrivo con una sola frase: cambiare vita."
  },
  {
   "tag": "h2",
   "y": 30912,
   "text": "FAQ"
  },
  {
   "tag": "h3",
   "y": 31004,
   "text": "FUNNEL OPERATOR"
  },
  {
   "tag": "h3",
   "y": 31039,
   "text": "Sono disponibili tutte le lezioni da subito?"
  },
  {
   "tag": "h3",
   "y": 31120,
   "text": "Posso fare Funnel Operator se sono principiante assoluto?"
  },
  {
   "tag": "h3",
   "y": 31201,
   "text": "Se compro questo corso divento ricco?"
  },
  {
   "tag": "h3",
   "y": 31282,
   "text": "Posso iniziare il corso se faccio già siti o copy?"
  },
  {
   "tag": "h3",
   "y": 31363,
   "text": "Mi serve saper programmare?"
  },
  {
   "tag": "h3",
   "y": 31444,
   "text": "Che iscrizioni mi servono?"
  },
  {
   "tag": "h3",
   "y": 31525,
   "text": "Se l'AI sa fare pagine, perché le aziende dovrebbero pagare me?"
  },
  {
   "tag": "h3",
   "y": 31606,
   "text": "Mi serve la partita IVA per fare landing pages?"
  },
  {
   "tag": "h3",
   "y": 31687,
   "text": "È garantito che avrò risultati?"
  },
  {
   "tag": "h3",
   "y": 31832,
   "text": "PAGAMENTO"
  },
  {
   "tag": "h3",
   "y": 31867,
   "text": "Quanto costa Funnel Operator?"
  },
  {
   "tag": "h3",
   "y": 31948,
   "text": "Posso pagare a rate?"
  },
  {
   "tag": "h3",
   "y": 32029,
   "text": "Posso avere fattura?"
  },
  {
   "tag": "h3",
   "y": 32110,
   "text": "Posso pagare con bonifico?"
  },
  {
   "tag": "h3",
   "y": 32191,
   "text": "Ho un problema con un ordine, a chi scrivo?"
  }
