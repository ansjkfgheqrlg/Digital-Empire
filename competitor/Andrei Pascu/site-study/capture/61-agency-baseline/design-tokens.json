 "headings": [
  {
   "tag": "h1",
   "text": "Automatizziamo la tua operatività con AI Workflows."
  },
  {
   "tag": "h2",
   "text": "Quello che automatizziamo, funziona."
  },
  {
   "tag": "h2",
   "text": "Due workflow. Un solo obiettivo: liberarti dall'operatività."
  },
  {
   "tag": "h3",
   "text": "Outreach Workflow"
  },
  {
   "tag": "h3",
   "text": "Content Workflow"
  },
  {
   "tag": "h3",
   "text": "Landing Page Premium + CRO Engineering"
  },
  {
   "tag": "h2",
   "text": "Il problema che blocca il 90% dei business."
  },
  {
   "tag": "h3",
   "text": "La tua giornata senza workflow"
  },
  {
   "tag": "h3",
   "text": "La tua giornata con i workflow"
  },
  {
   "tag": "h2",
   "text": "I 4 segnali che la tua operatività ti sta costando clienti."
  },
  {
   "tag": "h2",
   "text": "Se riconosci anche solo uno di quei 4 segnali..."
  },
  {
   "tag": "h2",
   "text": "Framework F.L.O.W."
  },
  {
   "tag": "h3",
   "text": "Flusso. Mappiamo tutto."
  },
  {
   "tag": "h3",
   "text": "Logica. Progettiamo il sistema."
  },
  {
   "tag": "h3",
   "text": "Output. Costruiamo e testiamo."
  },
  {
   "tag": "h3",
   "text": "Watch. Monitoriamo e ottimizziamo."
  },
  {
   "tag": "h2",
   "text": "Un workflow è una pipeline intelligente."
  },
  {
   "tag": "h2",
   "text": "Cinque step, zero ambiguità."
  },
  {
   "tag": "h3",
   "text": "Demo Call"
  },
  {
   "tag": "h3",
   "text": "Blueprint"
  },
  {
   "tag": "h3",
   "text": "Build"
  },
  {
   "tag": "h3",
   "text": "Go Live"
  },
  {
   "tag": "h3",
   "text": "Ottimizzazione"
  },
  {
   "tag": "h2",
   "text": "Nessun tool segreto. Solo quelli che usiamo ogni giorno."
  },
  {
   "tag": "h3",
   "text": "Make (Integromat)"
  },
  {
   "tag": "h3",
   "text": "n8n"
  },
  {
   "tag": "h3",
   "text": "Clay"
  },
  {
   "tag": "h3",
   "text": "Apollo.io"
  },
  {
   "tag": "h3",
   "text": "Claude AI"
  },
  {
   "tag": "h3",
   "text": "Instantly"
  },
  {
   "tag": "h3",
   "text": "HeyReach"
  },
  {
   "tag": "h3",
   "text": "Airtable"
  },
  {
   "tag": "h3",
   "text": "Notion"
  },
  {
   "tag": "h3",
   "text": "PhantomBuster"
  },
  {
   "tag": "h3",
   "text": "Buffer / Later"
  },
  {
   "tag": "h3",
   "text": "ElevenLabs"
  },
  {
   "tag": "h2",
   "text": "Non solo teoria. Lavori reali."
  },
  {
   "tag": "h2",
   "text": "Siamo Digital Empire. Costruiamo, non promettiamo."
  },
  {
   "tag": "h2",
   "text": "Tre persone. Zero filtri tra te e chi costruisce."
  },
  {
   "tag": "h3",
   "text": "Maximilian"
  },
  {
   "tag": "h3",
   "text": "Gael"
  },
  {
   "tag": "h3",
   "text": "Leonardo"
  },
  {
   "tag": "h2",
   "text": "Lavoriamo solo con chi possiamo davvero aiutare."
  },
  {
   "tag": "h3",
   "text": "Lavoriamo con te se..."
  },
  {
   "tag": "h3",
   "text": "Non lavoriamo con te se..."
  },
  {
   "tag": "h2",
   "text": "Quello che dicono di noi."
  },
  {
   "tag": "h2",
   "text": "“Ok, ma cosa include davvero il workflow?”"
  },
  {
   "tag": "h2",
   "text": "Se non funziona, lo sistemiamo gratis."
  },
  {
   "tag": "h2",
   "text": "Le 5 obiezioni che demoliamo prima di iniziare."
  },
  {
   "tag": "h3",
   "text": "“Costa troppo per quello che fa.”"
  },
  {
   "tag": "h3",
   "text": "“Ho già provato strumenti AI, non funzionano davvero.”"
  },
  {
   "tag": "h3",
   "text": "“Non vi conosco abbastanza per fidarmi.”"
  },
  {
   "tag": "h3",
   "text": "“Non ho tempo per implementare qualcosa di nuovo.”"
  },
  {
   "tag": "h3",
   "text": "“E se il workflow smette di funzionare dopo 2 mesi?”"
  },
  {
   "tag": "h2",
   "text": "Quello che ci chiedono."
  },
  {
   "tag": "h2",
   "text": "Automatizza ciò che ti blocca. Adesso."
  }
 ],
