 "headings": [
  {
   "tag": "h1",
   "text": "Il traffico si compra. I clienti si convertono."
  },
  {
   "tag": "h2",
   "text": "Il problema"
  },
  {
   "tag": "h2",
   "text": "La soluzione"
  },
  {
   "tag": "h2",
   "text": "Facciamo solo due cose. Per scelta."
  },
  {
   "tag": "h3",
   "text": "Landing page"
  },
  {
   "tag": "h3",
   "text": "Consulenza con Andrei Pascu"
  },
  {
   "tag": "h2",
   "text": "Metodo statistico. Non opinioni."
  },
  {
   "tag": "h3",
   "text": "Tracciamo"
  },
  {
   "tag": "h3",
   "text": "Guardiamo"
  },
  {
   "tag": "h3",
   "text": "Costruiamo"
  },
  {
   "tag": "h3",
   "text": "Misuriamo"
  },
  {
   "tag": "h3",
   "text": "Quello che vediamo"
  },
  {
   "tag": "h2",
   "text": "Non facciamo solo pagine. Orchestriamo la conversione."
  },
  {
   "tag": "h3",
   "text": "Offerta"
  },
  {
   "tag": "h3",
   "text": "Coerenza ads ↔ pagina"
  },
  {
   "tag": "h3",
   "text": "Fiducia"
  },
  {
   "tag": "h2",
   "text": "Agenzia generalista, freelancer o assumere? Nessuno dei tre."
  },
  {
   "tag": "h2",
   "text": "Piccola agenzia. Standard alti."
  },
  {
   "tag": "h2",
   "text": "Deleghiamo. Ma mai a caso."
  },
  {
   "tag": "h2",
   "text": "Domande frequenti."
  },
  {
   "tag": "h3",
   "text": "Cos'è la CRO?"
  },
  {
   "tag": "h3",
   "text": "Con chi lavorate?"
  },
  {
   "tag": "h3",
   "text": "Che tipo di accordo offrite?"
  },
  {
   "tag": "h3",
   "text": "E se le conversioni non aumentano?"
  },
  {
   "tag": "h3",
   "text": "Quanto costa?"
  },
  {
   "tag": "h3",
   "text": "Fate anche ads, social, SEO?"
  },
  {
   "tag": "h3",
   "text": "Quanto tempo devo dedicarci io?"
  },
  {
   "tag": "h2",
   "text": "Vediamo se ha senso lavorare insieme."
  }
