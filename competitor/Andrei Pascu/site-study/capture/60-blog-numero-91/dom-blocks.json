  "x": 446,
  "w": 236,
  "text": "Suggerimento +1 (bonus)",
  "inline": [],
  "color": "#fafafa",
  "size": 20,
  "weight": "700",
  "transform": "none",
  "align": "start",
  "href": null
 },
 {
  "tag": "p",
  "y": 5559,
  "x": 446,
  "w": 547,
  "text": "Quest’ultimo punto, è più un consiglio che una tecnica, che ti aiuterà a scegliere il titolo perfetto per il tuo copy.",
