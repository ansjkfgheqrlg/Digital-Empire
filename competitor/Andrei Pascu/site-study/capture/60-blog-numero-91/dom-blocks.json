 {
  "tag": "h1",
  "y": 263,
  "x": 446,
  "w": 547,
  "text": "Headline Copywriting: 9+1 Tecniche infallibili per il titolo perfetto",
  "inline": [],
  "color": "#fafafa",
  "size": 60.8,
  "weight": "700",
  "transform": "none",
  "align": "start",
  "href": null
 },
 {
  "tag": "p",
  "y": 693,
  "x": 486,
  "w": 467,
  "text": "“In media l’80% delle persone si ferma a leggere il titolo senza andare avanti. Quando hai scritto il tuo headline hai già speso 80 centesimi del tuo dollaro”. David Ogilvy",
  "inline": [
   "“In media l’80% delle persone si ferma a leggere il titolo senza andare avanti. Quando hai scritto il tuo headline hai già speso 80 centesimi del tuo dollaro”. David Ogilvy",
   "“In media l’80% delle persone si ferma a leggere il titolo senza andare avanti. Quando hai scritto il tuo headline hai già speso 80 centesimi del tuo dollaro”. David Ogilvy"
  ],
  "color": "#fafafa",
  "size": 16,
  "weight": "300",
  "transform": "none",
  "align": "start",
  "href": null
 },
 {
