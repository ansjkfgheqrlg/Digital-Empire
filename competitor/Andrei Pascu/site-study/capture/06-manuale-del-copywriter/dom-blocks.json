 {
  "tag": "h4",
  "y": 1416,
  "x": 737,
  "w": 383,
  "text": "Finisci il libro che non sai cosa fare",
  "inline": [],
  "color": "#1b1b1d",
  "size": 24,
  "weight": "700",
  "transform": "none",
  "align": "start",
  "href": null
