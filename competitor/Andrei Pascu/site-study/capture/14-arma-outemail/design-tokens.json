 "headings": [
  {
   "tag": "h1",
   "y": 95,
   "text": "Apriresti questa"
  },
  {
   "tag": "h1",
   "y": 169,
   "text": "email?"
  },
  {
   "tag": "h1",
   "y": 659,
   "text": "No, non l’apriresti. Anzi, la metteresti in spam."
  },
  {
   "tag": "h3",
   "y": 885,
   "text": "Eppure, questo è il livello di email marketing in Italia."
  },
  {
   "tag": "h2",
   "y": 1335,
   "text": "Che Dio riposi la sua anima…"
  },
  {
   "tag": "h2",
   "y": 1402,
   "text": "L’email marketing “classico” è morto."
  },
  {
   "tag": "h3",
   "y": 1800,
   "text": "Ma ora c’è qualcosa di meglio: Email marketing strategico. E qui le vendite sono matematiche."
  },
  {
   "tag": "h3",
   "y": 2331,
   "text": "AH, l’hai sentita la news? Leggi"
  },
  {
   "tag": "h2",
   "y": 2689,
   "text": "Ho una buona… E una pessima notizia."
  },
  {
   "tag": "h2",
   "y": 4167,
   "text": "L’email marketing “classico” è morto."
  },
  {
   "tag": "h2",
   "y": 4825,
   "text": "E i killer siamo stati noi… Noi marketer."
  },
  {
   "tag": "h3",
   "y": 5771,
   "text": "Abbiamo usato l’email marketing fino allo sfinimento. Adesso gli utenti hanno talmente tante email che non ci fanno più caso… I killer siamo noi…"
  },
  {
   "tag": "h2",
   "y": 6266,
   "text": "Ma sai cosa ho capito io e tante altre aziende che vendono a palate con le email?"
  },
  {
   "tag": "h1",
   "y": 7161,
   "text": "Guarda come sta messa l’azienda Italiana media con le mail."
  },
  {
   "tag": "h2",
   "y": 7782,
   "text": "Ora, è chiaro: nessuno di questi oggetti è persuasivo."
  },
  {
   "tag": "h2",
   "y": 8038,
   "text": "Guarda, invece, alcuni degli oggetti che io scrivo:"
  },
  {
   "tag": "h2",
   "y": 9066,
   "text": "Come si fa l’email"
  },
  {
   "tag": "h2",
   "y": 9133,
   "text": "marketing strategico?"
  },
  {
   "tag": "h2",
   "y": 11135,
   "text": "Segui le regole che spiego in outEmail e guarda i tuoi numeri salire come fosse una fottuta stat. di un videogame:"
  },
  {
   "tag": "h1",
   "y": 13269,
   "text": "Non è per tutti. Sono serio."
  },
  {
   "tag": "h1",
   "y": 14011,
   "text": "🤡: “Ma l’email marketing non funziona più” No. È il tuo email marketing che non funziona."
  },
  {
   "tag": "h2",
   "y": 15350,
   "text": "E se non comprano… Cosa stiamo facendo qui???? Siamo qui per vendere."
  },
  {
   "tag": "h1",
   "y": 15786,
   "text": "“Ma io so già scrivere email”"
  },
  {
   "tag": "h3",
   "y": 16529,
   "text": "Il prossimo livello di pensiero strategico per scrivere email di marketing killer"
  },
  {
   "tag": "h1",
   "y": 17634,
   "text": "“Andrei perché dovrei comprare outEmail e non i tuoi competitor?”"
  },
  {
   "tag": "h2",
   "y": 18076,
   "text": "Impara dal numero 1 copywriting icon come ribaltare il mercato in tuo favore con email di marketing da museo."
  },
  {
   "tag": "h1",
   "y": 18982,
   "text": "outEmail ha un ROI fuori"
  },
  {
   "tag": "h1",
   "y": 19038,
   "text": "da questo pianeta"
  },
  {
   "tag": "h1",
   "y": 20007,
   "text": "Lista video-lezioni"
  },
  {
   "tag": "h1",
   "y": 20911,
   "text": "Il futuro del marketing? Appartiene a chi usa il cervello."
  },
  {
   "tag": "h2",
   "y": 22366,
   "text": "I tuoi open rate saranno talmente alti da sembrare finti."
  },
  {
   "tag": "h1",
   "y": 23291,
   "text": "adesso disponibile."
  },
  {
   "tag": "h1",
   "y": 24216,
   "text": "FAQ"
  },
  {
   "tag": "h3",
   "y": 24355,
   "text": "Si parla anche di deliverability e compliance?"
  },
  {
   "tag": "h3",
   "y": 24539,
   "text": "Posso prenderlo se sono principiante?"
  },
  {
   "tag": "h3",
   "y": 24672,
   "text": "Sei sicuro che mi aiuterà?"
  },
  {
   "tag": "h3",
   "y": 24754,
   "text": "Da dove sono prese le strategie nel corso?"
  }
 ],
