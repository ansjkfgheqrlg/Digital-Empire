 "headings": [
  {
   "tag": "h1",
   "text": "Raggiungi la libertà finanziaria avviando una carriera da copywriter autonomo."
  },
  {
   "tag": "h2",
   "text": "Scopri di cosa si tratta ⬇️"
  },
  {
   "tag": "h1",
   "text": "La realtà dei fatti?"
  },
  {
   "tag": "h3",
   "text": "E lo afferma anche questo studio:"
  },
  {
   "tag": "h1",
   "text": "Ho scelto il copywriting dato che funziona anche durante i periodi di peggiore crisi:"
  },
  {
   "tag": "h1",
   "text": "Per chi ho creato Copywriting Mentorship:"
  },
  {
   "tag": "h3",
   "text": "Gli altri ti mettono 30 video-recensioni (sicuramente tutte realissime e non pagate 💀💀). Io ti mostro i dati."
  },
  {
   "tag": "h1",
   "text": "Cosa troverai in Copywriting Mentorship?"
  },
  {
   "tag": "h3",
   "text": "30+ video-lezioni su come scrivere copy"
  },
  {
   "tag": "h3",
   "text": "20+ video-lezioni su come trovare clienti"
  },
  {
   "tag": "h3",
   "text": "Riassunti e appunti"
  },
  {
   "tag": "h3",
   "text": "Quiz"
  },
  {
   "tag": "h3",
   "text": "Gruppo telegram privato"
  },
  {
   "tag": "h2",
   "text": "Copywriting Mentorship 6: ti insegno cosa funziona… Sulla base dei dati, in lezioni deep."
  },
  {
   "tag": "h2",
   "text": "Sono il mentore che cercavi."
  },
  {
   "tag": "h3",
   "text": "Dalla scrivania nella casa di un paesino ad un ufficio e azienda in centro a Bologna"
  },
  {
   "tag": "h3",
   "text": "Anche se a dire il vero…"
  },
  {
   "tag": "h3",
   "text": "Video testimonianze degli studenti"
  },
  {
   "tag": "h3",
   "text": "di Copywriting Mentorship."
  },
  {
   "tag": "h1",
   "text": "Impara a usare l’AI prima che sia lui a usare te"
  },
  {
   "tag": "h3",
   "text": "Come sfruttare l’AI per scrivere copy?"
  },
  {
   "tag": "h2",
   "text": "Un corso non è mai stato così completo…"
  },
  {
   "tag": "h3",
   "text": "Io ti do le informazioni, tu le sfrutti:"
  },
  {
   "tag": "h1",
   "text": "Le video-lezioni"
  },
  {
   "tag": "h3",
   "text": "Parte 1: come scrivere copy"
  },
  {
   "tag": "h3",
   "text": "Parte 2: come trovare clienti"
  },
  {
   "tag": "h3",
   "text": "Parte 3: Intelligenza artificiale"
  },
  {
   "tag": "h2",
   "text": "Contenuti per massimizzare il successo"
  },
  {
   "tag": "h1",
   "text": "Gruppo telegram privato"
  },
  {
   "tag": "h2",
   "text": "Consulenze direttamente con me"
  },
  {
   "tag": "h3",
   "text": "Non sei più solo."
  },
  {
   "tag": "h2",
   "text": "Diamo peso agli aggiornamenti di mercato:"
  },
  {
   "tag": "h2",
   "text": "Ecco il piano"
  },
  {
   "tag": "h1",
   "text": "“Non è un business sexy… Ma funziona”"
  },
  {
   "tag": "h2",
   "text": "La tua mano."
  },
  {
   "tag": "h2",
   "text": "A differenza di tutte le milioni di persone che stanno provando a fare copy…"
  },
  {
   "tag": "h2",
   "text": "Questo percorso lo descrivo con una sola frase: cambiare vita."
  },
  {
   "tag": "h2",
   "text": "Opinioni e risultati degli studenti di Copywriting Mentorship"
  },
  {
   "tag": "h3",
   "text": "Upgrade disponibile"
  },
  {
   "tag": "h2",
   "text": "Domande comuni"
  }
 ],
