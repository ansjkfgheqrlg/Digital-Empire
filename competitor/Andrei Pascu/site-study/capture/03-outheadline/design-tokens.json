 "headings": [
  {
   "tag": "h1",
   "text": "QUESTA È UNA"
  },
  {
   "tag": "h1",
   "text": "HEADLINE."
  },
  {
   "tag": "h2",
   "text": "E solo i copywriter che scrivono HEADLINE persuasive sono disperatamente richiesti… E guadagnano di più."
  },
  {
   "tag": "h1",
   "text": "…Ecco cosa succede se 1000"
  },
  {
   "tag": "h1",
   "text": "persone vedono la tua pagina:"
  },
  {
   "tag": "h1",
   "text": "Devi scrivere titoli migliori che impediscono ai clienti di skipparti così."
  },
  {
   "tag": "h1",
   "text": "Perché lasciare"
  },
  {
   "tag": "h1",
   "text": "soldi sul tavolo?!"
  },
  {
   "tag": "h3",
   "text": "La sales page te la può scrivere il miglior copy al mondo..."
  },
  {
   "tag": "h3",
   "text": "ma se il titolo non fa leggere i potenziali clienti... È come non avere la sales page"
  },
  {
   "tag": "h2",
   "text": "Se scrivi un titolo persuasivo, la gente legge… Se la gente legge, forse compra."
  },
  {
   "tag": "h2",
   "text": "Se scrivi titolo non persuasivo, la gente non legge… Se la gente non legge, al 100% non compra."
  },
  {
   "tag": "h2",
   "text": "Se sei un copywriter…"
  },
  {
   "tag": "h2",
   "text": "Se sei imprenditore che scrive copy da solo…"
  },
  {
   "tag": "h3",
   "text": "Andare da una versione all’altra di questa headline non è facile… Ci sono specifiche metodologie per farlo."
  },
  {
   "tag": "h2",
   "text": "Dove troverai tutte le strategie per scrivere headline che i copywriter elite si sono sempre tenuti per sé… Fino ad oggi."
  },
  {
   "tag": "h3",
   "text": "Le basi del copy sono ovunque… Ma la roba seria dove sta?"
  },
  {
   "tag": "h3",
   "text": "Hai bisogno di sentirti ripetere la solita formulina per la decima volta?! Naah 🥱"
  },
  {
   "tag": "h3",
   "text": "Sezioni A & B: introduzione al copy"
  },
  {
   "tag": "h3",
   "text": "Sezioni 1,2,3,4 & 5: come scrivere headline"
  },
  {
   "tag": "h1",
   "text": "outHeadline non è per principianti"
  },
  {
   "tag": "h1",
   "text": "“Per scrivere headline basta usare formule”"
  },
  {
   "tag": "h1",
   "text": "Gli 8 step per scrivere headline"
  },
  {
   "tag": "h3",
   "text": "Copywriter : campagna di marketing = cecchino : missione militare"
  },
  {
   "tag": "h3",
   "text": "“Un corso di più di 3 ore su come scrivere titoli? Ma sei pazzo?”"
  },
  {
   "tag": "h3",
   "text": "Le persone di successo sono quelle che fanno quello che serve, non quello “che vogliono”. Vale anche per i copywriter, non solo per discorsi motivazionali."
  },
  {
   "tag": "h1",
   "text": "Entrando in outHeadline e studiandolo… Sei più vicino al lavorare con multinazionali."
  },
  {
   "tag": "h1",
   "text": "Aggiornato al 2025… Ovviamente."
  },
  {
   "tag": "h1",
   "text": "outHeadline? Probabilmente non è per te. Ma se lo è… Stai per svoltare."
  }
 ],
