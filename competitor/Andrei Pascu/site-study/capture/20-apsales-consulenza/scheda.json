 "headings": [
  {
   "tag": "h1",
   "y": 319,
   "text": "Consulenza di problem solving con Andrei Pascu"
  },
  {
   "tag": "h2",
   "y": 1214,
   "text": "Qualsiasi cosa tu faccia… Hai un processo."
  },
  {
   "tag": "h2",
   "y": 1858,
   "text": "E ogni processo ha un limite che gli impedisce di crescere."
  },
  {
   "tag": "h2",
   "y": 3013,
   "text": "Ma chi è Andrei Pascu?"
  },
  {
   "tag": "h2",
   "y": 4246,
   "text": "Scopri e/o rimuovi il tuo vincolo."
  },
  {
   "tag": "h2",
   "y": 5941,
   "text": "I soldi si bloccano in uno di questi punti."
  },
  {
   "tag": "h2",
   "y": 7271,
   "text": "Nel 2024 ci sono stati 4,1 milioni di dichiaranti IVA in Italia."
  },
  {
   "tag": "h2",
   "y": 10460,
   "text": "Consulenza con Andrei Pascu."
  },
  {
   "tag": "h2",
   "y": 11299,
   "text": "Cosa succede dopo il pagamento."
  },
  {
   "tag": "h2",
   "y": 12147,
   "text": "Andrei Pascu vs consulente medio."
  },
  {
   "tag": "h2",
   "y": 13244,
   "text": "Quello che chiedono prima di pagare."
  },
  {
   "tag": "h3",
   "y": 13428,
   "text": "Fate fattura?"
  },
  {
   "tag": "h3",
   "y": 13524,
   "text": "Posso pagare con bonifico?"
  },
  {
   "tag": "h3",
   "y": 13620,
   "text": "La consulenza è con Andrei Pascu?"
  },
  {
   "tag": "h3",
   "y": 13716,
   "text": "Andrei usa l'AI per darmi consigli?"
  },
  {
   "tag": "h3",
   "y": 13812,
   "text": "Il riassunto che ricevo entro 48h è fatto dall'AI?"
  },
  {
   "tag": "h3",
   "y": 13908,
   "text": "È possibile fare la consulenza in presenza?"
  },
  {
   "tag": "h3",
   "y": 14005,
   "text": "In questa call mi verranno venduti servizi?"
  },
  {
   "tag": "h3",
   "y": 14101,
   "text": "Cosa devo preparare prima della call?"
  },
  {
   "tag": "h3",
   "y": 14197,
   "text": "Chi vede la registrazione della call?"
  },
  {
   "tag": "h3",
   "y": 14293,
   "text": "Posso portare un socio o una persona del team?"
  },
  {
   "tag": "h3",
   "y": 14389,
   "text": "Devo spostare la consulenza. Si può?"
  },
  {
   "tag": "h3",
   "y": 14485,
   "text": "Un'ora basta davvero?"
  },
  {
   "tag": "h3",
   "y": 14581,
   "text": "E se il mio problema non rientra nelle aree di Andrei?"
  },
  {
   "tag": "h3",
   "y": 14716,
   "text": "Ci sono aree che Andrei non copre?"
  },
  {
   "tag": "h2",
   "y": 15132,
   "text": "Sblocca il vincolo. Ottieni il tuo piano."
  }
 ],
