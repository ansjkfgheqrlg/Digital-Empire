 "headings": [
  {
   "tag": "h1",
   "y": 314,
   "text": "La mia storia."
  },
  {
   "tag": "h3",
   "y": 933,
   "text": "Come sono diventato indipendente guadagnando migliaia di euro online."
  },
  {
   "tag": "h3",
   "y": 1764,
   "text": "Come tutto è iniziato."
  },
  {
   "tag": "h2",
   "y": 2561,
   "text": "Hai presente questo sentimento?"
  },
  {
   "tag": "h2",
   "y": 3668,
   "text": "Il mio primo progetto imprenditoriale"
  },
  {
   "tag": "h2",
   "y": 4913,
   "text": "Come ho iniziato"
  },
  {
   "tag": "h3",
   "y": 7258,
   "text": "“Ca**o… Questa è la mia opportunità”"
  },
  {
   "tag": "h3",
   "y": 8008,
   "text": "Il mio obiettivo era chiaro: creare il corso di copy più completo in Italia."
  },
  {
   "tag": "h2",
   "y": 8887,
   "text": "Bologna"
  },
  {
   "tag": "h2",
   "y": 10207,
   "text": "Per il mio futuro"
  },
  {
   "tag": "h2",
   "y": 10730,
   "text": "Perché ho scelto il copywriting"
  },
  {
   "tag": "h2",
   "y": 11791,
   "text": "Come iniziare (velocemente)"
  },
  {
   "tag": "h2",
   "y": 12362,
   "text": "Vuoi imparare direttamente da me?"
  },
  {
   "tag": "h3",
   "y": 13605,
   "text": "Se non sai proprio da dove iniziare, clicca qui e dai un’occhiata👇"
  }
 ],
