 "headings": [
  {
   "tag": "h1",
   "y": 296,
   "text": "Ti formo su Claude Code. 45 minuti. Gratis."
  },
  {
   "tag": "h2",
   "y": 1382,
   "text": "ASCOLTA BENE."
  },
  {
   "tag": "h2",
   "y": 2004,
   "text": "Tutti ti vendono corsi. Nessuno ti fa vedere come fa."
  },
  {
   "tag": "h3",
   "y": 2186,
   "text": "Il corso tipico"
  },
  {
   "tag": "h3",
   "y": 2173,
   "text": "Questa call"
  },
  {
   "tag": "h2",
   "y": 2678,
   "text": "Non parliamo di AI. Costruiamo qualcosa con l'AI."
  },
  {
   "tag": "h3",
   "y": 2897,
   "text": "Capisco dove sei oggi"
  },
  {
   "tag": "h3",
   "y": 3063,
   "text": "Ti mostro come lavoro io"
  },
  {
   "tag": "h3",
   "y": 3255,
   "text": "Costruiamo il tuo primo pezzo"
  },
  {
   "tag": "h2",
   "y": 3579,
   "text": "Per chi è questa call (e per chi non è)."
  },
  {
   "tag": "h2",
   "y": 4512,
   "text": "Esattamente cosa succede nei prossimi giorni."
  },
  {
   "tag": "h3",
   "y": 4704,
   "text": "Subito — Conferma + mini-form"
  },
  {
   "tag": "h3",
   "y": 4816,
   "text": "24h prima — Promemoria + preparazione"
  },
  {
   "tag": "h3",
   "y": 4954,
   "text": "Il giorno della call — 45 min live"
  },
  {
   "tag": "h3",
   "y": 5066,
   "text": "Subito dopo — Registrazione + note"
  },
  {
   "tag": "h3",
   "y": 5204,
   "text": "7 giorni dopo — Check rapido"
  },
  {
   "tag": "h2",
   "y": 5511,
   "text": "La differenza in 45 minuti."
  },
  {
   "tag": "h3",
   "y": 5754,
   "text": "Il loop infinito"
  },
  {
   "tag": "h3",
   "y": 5754,
   "text": "La chiarezza"
  },
  {
   "tag": "h2",
   "y": 6208,
   "text": "Quanto vale davvero questa sessione."
  },
  {
   "tag": "h2",
   "y": 7123,
   "text": "Ancora scettico?"
  },
  {
   "tag": "h2",
   "y": 7705,
   "text": "\"Ok ma perché me la date gratis?\""
  },
  {
   "tag": "h2",
   "y": 8452,
   "text": "Faccio max 8 call a settimana."
  },
  {
   "tag": "h2",
   "y": 8931,
   "text": "Le 3 obiezioni che ricevo sempre."
  },
  {
   "tag": "h3",
   "y": 9060,
   "text": "\"Non so se ho il livello giusto\""
  },
  {
   "tag": "h3",
   "y": 9219,
   "text": "\"Sembra troppo bello per essere gratis\""
  },
  {
   "tag": "h3",
   "y": 9408,
   "text": "\"Ho paura di perdere tempo\""
  },
  {
   "tag": "h2",
   "y": 9813,
   "text": "\"Ok ma tu chi sei?\""
  },
  {
   "tag": "h2",
   "y": 10343,
   "text": "Cosa esci con, dopo 45 minuti."
  },
  {
   "tag": "h3",
   "y": 10556,
   "text": "Un workflow tuo"
  },
  {
   "tag": "h3",
   "y": 10556,
   "text": "Ore recuperate"
  },
  {
   "tag": "h3",
   "y": 10556,
   "text": "Chiarezza brutale"
  },
  {
   "tag": "h2",
   "y": 10930,
   "text": "Cosa dicono chi ha già fatto la call"
  },
  {
   "tag": "h2",
   "y": 11648,
   "text": "Se dopo 10 minuti non ti sto dando valore, chiudi la call."
  },
  {
   "tag": "h2",
   "y": 12071,
   "text": "Domande che mi fanno spesso"
  },
  {
   "tag": "h3",
   "y": 12196,
   "text": "Serve che abbia già Claude installato?"
  },
  {
   "tag": "h3",
   "y": 12307,
   "text": "Registri la call?"
  },
  {
   "tag": "h3",
   "y": 12418,
   "text": "Che tool serve?"
  },
  {
   "tag": "h3",
   "y": 12529,
   "text": "Devo saper programmare?"
  },
  {
   "tag": "h3",
   "y": 12692,
   "text": "Si parla solo di Claude Code?"
  },
  {
   "tag": "h3",
   "y": 12855,
   "text": "Posso portare un mio progetto?"
  },
  {
   "tag": "h3",
   "y": 12966,
   "text": "Cosa NON facciamo in 45 minuti?"
  },
  {
   "tag": "h2",
   "y": 13352,
   "text": "Niente tool segreti. Solo quelli che uso davvero."
  },
  {
   "tag": "h2",
   "y": 14472,
   "text": "Marco, founder SaaS. Da 3 ore a 20 minuti."
  },
  {
   "tag": "h2",
   "y": 15052,
   "text": "Esci dalla call con sei cose molto concrete."
  },
  {
   "tag": "h3",
   "y": 15309,
   "text": "Un workflow funzionante"
  },
  {
   "tag": "h3",
   "y": 15309,
   "text": "Una mappa mentale chiara"
  },
  {
   "tag": "h3",
   "y": 15491,
   "text": "2-3 prompt pattern riutilizzabili"
  },
  {
   "tag": "h3",
   "y": 15491,
   "text": "La registrazione completa"
  },
  {
   "tag": "h3",
   "y": 15672,
   "text": "Un ordine di priorità"
  },
  {
   "tag": "h3",
   "y": 15672,
   "text": "Accesso diretto per domande"
  },
  {
   "tag": "h2",
   "y": 16068,
   "text": "Corso da 800€ vs questa call gratis."
  },
  {
   "tag": "h2",
   "y": 16949,
   "text": "Max, founder di Digital Empire. Builder, non formatore."
  },
  {
   "tag": "h2",
   "y": 17720,
   "text": "“Se è gratis, dov'è la fregatura?”"
  },
  {
   "tag": "h2",
   "y": 18270,
   "text": "45 minuti. Gratis. Per davvero."
  }
