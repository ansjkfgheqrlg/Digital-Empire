 "headings": [
  {
   "tag": "h1",
   "text": "Ti costa uno stipendio un lavoro che si fa da solo."
  },
  {
   "tag": "h2",
   "text": "Ti voglio bene, ma lo stai facendo a mano."
  },
  {
   "tag": "h3",
   "text": "I quattro segnali. Ne basta uno."
  },
  {
   "tag": "h2",
   "text": "Quello che installiamo, misurato."
  },
  {
   "tag": "h2",
   "text": "Hai competitor e non lo sai."
  },
  {
   "tag": "h2",
   "text": "ASCOLTA BENE."
  },
  {
   "tag": "h2",
   "text": "A mano, con un tool, con un sistema tuo."
  },
  {
   "tag": "h3",
   "text": "A mano"
  },
  {
   "tag": "h3",
   "text": "Con un tool (SaaS)"
  },
  {
   "tag": "h3",
   "text": "Con un sistema tuo"
  },
  {
   "tag": "h2",
   "text": "Alle 7:40 ha già mandato 300 messaggi."
  },
  {
   "tag": "h3",
   "text": "Un argomento entra. Carosello, reel, caption escono."
  },
  {
   "tag": "h3",
   "text": "La tua azienda sa tutto. Sempre."
  },
  {
   "tag": "h2",
   "text": "Produttività = cose utili fatte / ore tue."
  },
  {
   "tag": "h3",
   "text": "Il conto del canone"
  },
  {
   "tag": "h2",
   "text": "Dal contratto al go-live senza mesi di sviluppo."
  },
  {
   "tag": "h2",
   "text": "Un caso coi numeri contati. Le facce le stiamo raccogliendo."
  },
  {
   "tag": "h2",
   "text": "Lavoriamo solo con chi ha già qualcosa che funziona."
  },
  {
   "tag": "h2",
   "text": "Parli con chi ha le mani sui workflow. Per scelta, non per limite."
  },
  {
   "tag": "h3",
   "text": "Maximilian (Max)"
  },
  {
   "tag": "h3",
   "text": "Gael"
  },
  {
   "tag": "h3",
   "text": "Leonardo"
  },
  {
   "tag": "h2",
   "text": "Un sistema. Un prezzo. Una volta."
  },
  {
   "tag": "h3",
   "text": "In ogni sistema, sempre"
  },
  {
   "tag": "h2",
   "text": "Funziona come scritto nel contratto, o lo sistemiamo noi."
  },
  {
   "tag": "h2",
   "text": "Le sei cose che stai pensando. In ordine."
  },
  {
   "tag": "h2",
   "text": "Cosa ottieni se prenoti adesso."
  },
  {
   "tag": "h2",
   "text": "Domande che ci fanno davvero."
  },
  {
   "tag": "h2",
   "text": "In chiamata la vedi girare."
  }
 ],
