{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APEX-7 Memory Ecosystem Schema",
  "description": "Schema completo per i 5 layer della memoria di APEX-7",
  "definitions": {
    "WorkingMemory": {
      "type": "object",
      "required": ["session_id", "started_at", "user_goal"],
      "properties": {
        "session_id": { "type": "string", "pattern": "^sess-[a-f0-9]+$" },
        "started_at": { "type": "string", "format": "date-time" },
        "user_goal": { "type": "string" },
        "goal_interpreted": { "type": "string" },
        "current_level": { "type": "integer", "minimum": 1, "maximum": 7 },
        "current_cycle": { "type": "integer", "minimum": 0 },
        "active_plan": {
          "type": "object",
          "properties": {
            "plan_id": { "type": "string" },
            "subtasks": { "type": "array" },
            "current_subtask": { "type": "string" },
            "completed_subtasks": { "type": "array" }
          }
        },
        "current_draft": {
          "type": "object",
          "properties": {
            "version": { "type": "integer" },
            "content": { "type": "string" },
            "author": { "type": "string", "enum": ["WRITER", "REFINER"] },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "last_critique": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "verdict": { "type": "string", "enum": ["PASS", "REFINE", "RESTART"] },
            "critical_issues": { "type": "array" }
          }
        },
        "agent_states": {
          "type": "object",
          "properties": {
            "PLANNER": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "ANALYST": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "WRITER": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "CRITIC": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "REFINER": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "GATE_AGENT": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] },
            "META_AGENT": { "type": "string", "enum": ["IDLE", "ACTIVE", "DONE"] }
          }
        }
      }
    },
    "DecisionLog": {
      "type": "object",
      "required": ["decision_id", "session_id", "timestamp", "author_agent", "decision", "reasoning"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^DEC-[a-f0-9]+$" },
        "session_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "author_agent": { "type": "string" },
        "decision_type": { "type": "string", "enum": ["STRATEGIC", "TACTICAL", "OPERATIONAL"] },
        "decision": { "type": "string" },
        "reasoning": { "type": "string" },
        "alternatives_considered": { "type": "array" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "expected_outcome": { "type": "string" },
        "actual_outcome": { "type": "string" },
        "outcome_score": { "type": "number" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUPERSEDED", "ARCHIVED"] }
      }
    },
    "StrategyStore": {
      "type": "object",
      "required": ["strategy_id", "name", "category", "description"],
      "properties": {
        "strategy_id": { "type": "string", "pattern": "^STR-[a-f0-9]+$" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["PLANNING", "WRITING", "ANALYSIS", "CRITIQUE", "REFINING", "ORCHESTRATION", "GENERAL"] },
        "description": { "type": "string" },
        "when_to_use": { "type": "string" },
        "when_NOT_to_use": { "type": "string" },
        "parameters": { "type": "object" },
        "steps": { "type": "array" },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "times_used": { "type": "integer" },
        "last_used": { "type": "string", "format": "date-time" },
        "avg_quality_improvement": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "DEPRECATED", "EXPERIMENTAL"] }
      }
    }
  }
}
