{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/mkd.schema.json",
  "title": "Master Knowledge Document (MKD) — output di Stage 4",
  "description": "Forma canonica del documento perfetto ampliato prodotto da A5 mkd-builder-agent.",
  "type": "object",
  "schema_version": "0.1.0-draft",
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "master.md",
        "glossary.md",
        "faq.md",
        "schemas.md",
        "changelog.md",
        "mkd-report.json"
      ]
    },
    "master_md": {
      "type": "object",
      "description": "Struttura attesa di master.md",
      "properties": {
        "frontmatter_required_keys": {
          "type": "array",
          "const": [
            "title",
            "generated_by",
            "generated_at",
            "forge_target",
            "sources_count",
            "atoms_count"
          ]
        },
        "required_top_sections": {
          "type": "array",
          "const": [
            "Overview",
            "Indice",
            "Cross-reference",
            "Indice analitico"
          ]
        },
        "min_length_ratio_vs_source": {
          "type": "number",
          "const": 1.2
        },
        "min_atoms_coverage": {
          "type": "number",
          "const": 1.0,
          "description": "MKD richiede 100%"
        }
      }
    },
    "mkd_report_required_fields": {
      "type": "array",
      "const": [
        "status",
        "stats",
        "iteration"
      ]
    },
    "stats_required_fields": {
      "type": "array",
      "const": [
        "atoms_total",
        "atoms_covered",
        "coverage_rate",
        "source_words",
        "mkd_words",
        "ratio",
        "examples_from_source",
        "examples_added",
        "schemas_generated",
        "cross_refs_internal",
        "glossary_terms",
        "faq_questions",
        "sources_processed"
      ]
    },
    "quality_thresholds": {
      "type": "object",
      "const": {
        "atoms_coverage": 1.0,
        "length_ratio_vs_source": 1.2,
        "added_examples_rate": 0.5,
        "schemas_for_structured_clusters": 1.0,
        "min_cross_refs_per_cluster": 2,
        "min_faq_questions": 5
      }
    }
  }
}