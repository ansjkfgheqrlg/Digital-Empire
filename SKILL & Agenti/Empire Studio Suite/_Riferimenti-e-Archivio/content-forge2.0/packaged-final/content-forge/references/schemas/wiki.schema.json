{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/wiki.schema.json",
  "title": "Wiki target output structure (Obsidian)",
  "type": "object",
  "schema_version": "0.2.0-draft",
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "_Index.md",
        "README.md",
        "_meta/source.md",
        "_meta/import-log.md"
      ]
    },
    "required_pattern_files": {
      "type": "array",
      "const": [
        "MOC - *.md"
      ]
    },
    "required_directories": {
      "type": "array",
      "const": [
        "concepts",
        "_meta"
      ]
    },
    "optional_directories": {
      "type": "array",
      "const": [
        "examples",
        "frameworks",
        "procedures",
        "glossary"
      ]
    },
    "wikilink_integrity_required": {
      "type": "boolean",
      "const": true
    },
    "frontmatter_required_per_note": {
      "type": "boolean",
      "const": true
    }
  }
}