# Copia questo file in `.env` e compila i valori. `.env` non e' versionato (vedi .gitignore).
# NON inserire qui credenziali reali: questo file e' un TEMPLATE versionato.

# --- Nicchia primaria (protetta: solo il livello senior puo' proporne il cambio) ---
YAF_PRIMARY_NICHE="Dose Mentale"

# --- Percorsi ---
YAF_REPORTS_DIR="reports"

# --- Playwright (comune) ---
YAF_BROWSER_HEADLESS=true
YAF_BROWSER_TIMEOUT_MS=30000
# Directory del profilo browser persistente. Lasciare vuoto per usare un contesto effimero.
YAF_BROWSER_PROFILE_DIR=""

# --- YouTube ---
YAF_YOUTUBE_BASE_URL="https://www.youtube.com"
# Selettori CSS: NON sono precompilati di proposito. Il layout di YouTube cambia nel tempo e
# selettori non verificati produrrebbero dati falsi. Vanno rilevati e inseriti dall'operatore.
# Formato: JSON con le chiavi documentate in docs/architecture.md
# Esempio (da verificare prima dell'uso): {"video_card": "...", "title": "...", "views": "..."}
YAF_YOUTUBE_SELECTORS=""

# --- Arena (generazione copertine) ---
YAF_ARENA_BASE_URL=""
YAF_ARENA_SELECTORS=""

# --- Flik (produzione video) ---
# L'adapter reale NON e' implementato: non esiste in questo repository una specifica API
# verificata. Valori ammessi: "mock" (default) oppure il nome di un adapter registrato.
YAF_FLIK_ADAPTER="mock"
