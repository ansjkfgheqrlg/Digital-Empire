# ============================================================
# EMPIRE OS — .gitignore del monorepo Digital Empire
# Regola: conoscenza, codice, piani, wiki = TRACCIATI.
# Segreti, sessioni browser, build, vendor, media giganti = NO.
# ============================================================

# --- SEGRETI E CREDENZIALI (mai su GitHub) ---
.env
.env.*
*.env
!.env.example
!*.env.example
**/credentials.json
**/token.json
**/client_secret*.json
*.pem
*.key
*.session
*session*.json
**/*session*.json
**/sessions/
**/cookies*.json
**/cookies*.pkl
*.pickle
token*.pickle

# --- PROFILI BROWSER / SESSIONI AUTOMAZIONE (cookie, history, cache) ---
maps_session/
**/maps_session/
session_data/
**/session_data/
**/chrome-profile*/
**/whatsapp-profile*/
**/browser-data*/
**/User Data/
**/Default/Cache/
**/Default/Cookies*

# --- DATI OPERATIVI LOCALI CON PII (lead DB: per-macchina, non si sincronizza) ---
Outreach/**/*.db
Outreach/**/*.sqlite*
Outreach/**/data/leads_*.csv
Outreach/**/output_*.json
WORKFLOW-ESTATE/**/lead.csv

