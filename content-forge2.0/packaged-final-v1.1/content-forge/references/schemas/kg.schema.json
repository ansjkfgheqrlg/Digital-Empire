{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/kg.schema.json",
  "title": "Knowledge Graph (kg.json)",
  "description": "Output di Stage 3 (A3 knowledge-graph-agent). Lingua franca consumata da ogni builder.",
  "type": "object",
  "schema_version": "0.2.0-draft",
  "required": [
    "version",
    "generated_at",
    "source_meta",
    "stats",
    "atoms",
    "clusters",
    "edges",
    "gaps"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_meta": {
      "type": "object",
      "required": [
        "path",
        "word_count",
        "language"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "string"
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "atom_count",
        "cluster_count",
        "edge_count"
      ],
      "properties": {
        "atom_count": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_groups_merged": {
          "type": "integer",
          "minimum": 0
        },
        "gap_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "canonical_definition",
          "cluster_id",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^a-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "concept",
              "claim",
              "procedure",
              "example",
              "framework",
              "definition"
            ]
          },
          "canonical_definition": {
            "type": "string",
            "minLength": 10
          },
          "extended_explanation": {
            "type": "string"
          },
          "source_excerpts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_offsets": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "examples_from_source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated_examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cluster_id": {
            "type": "string",
            "pattern": "^c-[0-9]{3,}$"
          },
          "review_needed": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "atom_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c-[0-9]{3,}$"
          },
          "label": {
            "type": "string"
          },
          "atom_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "one_liner": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "prerequisite",
              "depends_on",
              "is_a",
              "part_of",
              "sibling_of",
              "see_also",
              "contrasts",
              "applies_in",
              "example_of"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "missing_concept"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mentioned_in_atoms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_concept": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}