# ============================================================
# .env — Digital Empire Outreach
# ============================================================
# 1. Copia questo file come .env nella stessa cartella
# 2. Compila tutti i valori
# 3. Leggi SETUP.md per istruzioni dettagliate
# ============================================================

# ── ANTHROPIC ───────────────────────────────────────────────
# Prendi da: https://console.anthropic.com/keys
# Costo: ~$0.50 per 500 email/giorno
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── FACEBOOK AD LIBRARY ─────────────────────────────────────
# GRATUITO. Setup 5 minuti. Leggi SETUP.md sezione 2.
# Prendi da: https://developers.facebook.com/tools/explorer
FB_ACCESS_TOKEN=EAAg...

# ── GMAIL ───────────────────────────────────────────────────
# La tua email personale (mittente delle email)
GMAIL_USER=max.infoproducer@gmail.com

# App Password — NON la password normale!
# Genera in 2 min: myaccount.google.com/apppasswords
# Aspetto: 16 caratteri senza spazi (es. abcdefghijklmnop)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── LINK PIVOT (implementazioni AI) ─────────────────────────
# Questi link vengono messi GIÀ NEL PRIMO MESSAGGIO su tutti i canali.
# (Sono già hardcoded come costanti in knowledge/apsoc.py e nei config
#  LinkedIn/Instagram — qui sono opzionali, per override via env.)
PRESENTATION_URL=https://presentazione-empire.vercel.app/
AGENCY_URL=https://agency-empire-kohl.vercel.app
# Sconto da citare nella CTA — modifica qui lo sconto reale di lancio
LAUNCH_OFFER=sconto early-adopter per i primi clienti che partono questo mese
