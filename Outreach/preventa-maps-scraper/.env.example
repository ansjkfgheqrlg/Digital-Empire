# Preventa Maps Scraper - Playwright + Sheets
# Copia in .env -> cp .env.example .env

# --- Playwright: nessuna key richiesta ---

# --- Google Sheets (opzionale, solo se usi --sheet-id) ---
# ID del foglio: prendi dalla URL https://docs.google.com/spreadsheets/d/{QUESTO_ID}/edit
GOOGLE_SHEET_ID=1abc...tuo_id_foglio...

# Path al file JSON del service account (scaricato da Google Cloud)
GOOGLE_SHEETS_CREDS_PATH=credentials.json

# Nome worksheet dentro il file
# GOOGLE_SHEETS_WORKSHEET=Foglio1
