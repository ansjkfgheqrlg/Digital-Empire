  {
   "uid": "L5_Z63nxXjI::KA-04",
   "ka_id": "KA-04",
   "run": "L5_Z63nxXjI",
   "tipo": "Copy / Show don't tell",
   "contenuto": "Nominare una parola astratta come 'prestigio' da sola non basta a dare la sensazione di lusso/status — serve fornire informazioni visive, sensoriali ed emotive che permettano al lettore di 'entrare nel ruolo' (esempio: 'stai salendo al cinquantesimo piano, entri nel tuo penthouse'). Tecnica: Show, don't tell — dimostrare la sensazione con un'immagine concreta invece di dichiararla con un'etichetta astratta.",
   "ancora": "",
   "fonte": "L5_Z63nxXjI#00:02:53",
