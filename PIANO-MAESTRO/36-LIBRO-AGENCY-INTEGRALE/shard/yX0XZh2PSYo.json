  },
  {
   "uid": "yX0XZh2PSYo::KA-05",
   "ka_id": "KA-05",
   "run": "yX0XZh2PSYo",
   "tipo": "Metodo / Merge tag fallback",
   "contenuto": "Soluzione: con alcuni CRM puoi impostare un fallback alternativo al posto dello spazio vuoto — sintassi tipo 'Ciao, [nome/iscritto], offerta per te': se c'e' il nome, il sistema stampa 'Ciao, Andrei'; se il nome manca, stampa 'Ciao, Iscritto' invece di lasciare un buco. Logica condizionale: campo primario -> se assente, campo/valore di riserva.",
   "ancora": "",
   "fonte": "yX0XZh2PSYo#00:00:50",
   "frame": "frame-028,029,030",
   "confidenza": "",
