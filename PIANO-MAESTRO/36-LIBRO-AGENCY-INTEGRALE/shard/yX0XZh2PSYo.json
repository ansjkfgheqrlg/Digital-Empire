  },
  {
   "uid": "yX0XZh2PSYo::KA-04",
   "ka_id": "KA-04",
   "run": "yX0XZh2PSYo",
   "tipo": "Copy / Anti-pattern personalizzazione",
   "contenuto": "Problema pratico: se scrivi 'Ciao, [nome],' e il destinatario non ha un nome registrato nel CRM, con un merge tag semplice quello spazio dopo 'Ciao,' rimane vuoto — un difetto visibile che rovina la mail personalizzata.",
