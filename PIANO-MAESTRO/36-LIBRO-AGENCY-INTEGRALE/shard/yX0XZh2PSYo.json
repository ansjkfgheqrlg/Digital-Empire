  },
  {
   "uid": "yX0XZh2PSYo::KA-06",
   "ka_id": "KA-06",
   "run": "yX0XZh2PSYo",
   "tipo": "Metodo / Merge tag fallback - generalizzazione",
   "contenuto": "La stessa tecnica di fallback non si limita al saluto iniziale: si puo' applicare a qualunque altro merge tag nel corpo dell'email, es. '[nome/CTA]', '[nome/Senti]' o '[nome/Ascolta]' per invitare a 'leggere bene' in modo naturale anche quando manca il dato primario — il pattern condizionale e' riutilizzabile su qualsiasi punto del copy, non solo sul nome.",
   "ancora": "",
   "fonte": "yX0XZh2PSYo#00:01:06",
