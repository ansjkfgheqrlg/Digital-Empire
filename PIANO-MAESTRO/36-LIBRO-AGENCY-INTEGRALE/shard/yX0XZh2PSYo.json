   "uid": "yX0XZh2PSYo::KA-01",
   "ka_id": "KA-01",
   "run": "yX0XZh2PSYo",
   "tipo": "Copy / Personalizzazione - esempio",
   "contenuto": "Esempio d'apertura: quando un brand come Decathlon manda una mail promozionale, il testo cambia in automatico in base al nome fornito dall'utente in fase di iscrizione ('Ciao Andrei...' / 'Ciao Maria...' / 'Ciao Roberto...'). Il dato (nome, data di nascita, genere) viene raccolto al momento della creazione dell'account e riutilizzato per personalizzare le comunicazioni successive.",
   "ancora": "",
   "fonte": "yX0XZh2PSYo#00:00:00",
