  },
  {
   "uid": "jgIgOPAnYNY::KA-05",
   "ka_id": "KA-05",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Briefing",
   "contenuto": "L'USP (Unique Selling Point) risponde a 'perche' il mio e non quello degli altri?' - ogni brand degno ha un USP diversificante. Esempi citati: Razer (gaming hardcore), Logitech (versatility), iPhone (ecosystem/status). Senza USP il copy e' generico.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:02:55",
   "frame": "",
   "confidenza": "",
   "tags": [
    "briefing",
    "usp",
    "posizionamento"
   ],
   "relazioni": [],
