  {
   "uid": "jgIgOPAnYNY::KA-15",
   "ka_id": "KA-15",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Formula APSOC (CHIAVE)",
   "contenuto": "APSOC e' la formula proprietaria di scrittura di Andrei Pascu: Attenzione -> Problema -> Soluzione -> Obiezioni -> Call To Action. Diversa dalla AIDA classica perche' aggiunge esplicitamente la O (obiezioni), step spesso omesso altrove.",
   "ancora": "",
