  {
   "uid": "jgIgOPAnYNY::KA-12",
   "ka_id": "KA-12",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Metodo di ricerca",
   "contenuto": "La ricerca serve a usare le stesse parole del target nel copy - 'voice of customer' come fonte di linguaggio autentico. Il copy scritto con le parole del target risuona istantaneamente; il copy scritto con parole del copywriter suona artificiale e non converte.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:12:30",
   "frame": "",
   "confidenza": "",
   "tags": [
    "ricerca",
    "voice-of-customer",
    "linguaggio"
   ],
