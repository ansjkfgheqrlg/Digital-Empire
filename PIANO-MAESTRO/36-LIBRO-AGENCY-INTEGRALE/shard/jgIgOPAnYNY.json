  {
   "uid": "jgIgOPAnYNY::KA-04",
   "ka_id": "KA-04",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Briefing",
   "contenuto": "Il Pain Point e' il problema che il prodotto risolve - obbligatorio nel briefing, non opzionale. Senza pain point identificato, il copy non puo' agitare la sofferenza del target: il pain precede la soluzione nella struttura APSOC.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:02:10",
   "frame": "frame-100",
   "confidenza": "",
   "tags": [
    "briefing",
    "pain-point",
    "psicologia"
   ],
   "relazioni": [],
   "file_sorgente": "C:/Users/Utente/Desktop/qui tutto/Digital Empire/.claude/skills/empire-studio/memory-empire/knowledge/jgIgOPAnYNY/atoms.json",
   "parole": 37,
