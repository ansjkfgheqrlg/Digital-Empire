  },
  {
   "uid": "jgIgOPAnYNY::KA-18",
   "ka_id": "KA-18",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / APSOC - Soluzione",
   "contenuto": "S = Soluzione: presentare il prodotto come risposta diretta al problema agitato ('Spray XXL x2000, l'unico spray che grazie agli agenti chimici avanzati pulisce anche le macchie piu' testarde'). La soluzione deve legarsi direttamente al pain, non presentare feature generiche.",
   "ancora": "",
