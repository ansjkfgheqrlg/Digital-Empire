  },
  {
   "uid": "jgIgOPAnYNY::KA-07",
   "ka_id": "KA-07",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Briefing",
   "contenuto": "Il branding aziendale (tone of voice) deve essere rispettato - il copy NON puo' essere uguale per tutti i brand. Esempio Andrei: il suo stile e' 'freddo/diretto' - lo stesso copy per un brand caldo/inclusivo sarebbe dissonante e dannoso.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:04:10",
   "frame": "frame-200",
   "confidenza": "",
   "tags": [
    "briefing",
    "tone-of-voice",
    "brand"
   ],
   "relazioni": [],
   "file_sorgente": "C:/Users/Utente/Desktop/qui tutto/Digital Empire/.claude/skills/empire-studio/memory-empire/knowledge/jgIgOPAnYNY/atoms.json",
