  },
  {
   "uid": "jgIgOPAnYNY::KA-08",
   "ka_id": "KA-08",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Briefing",
   "contenuto": "Il contesto funnel/consapevolezza determina il copy da scrivere - audience fredda vs calda richiedono approcci opposti. Esempio: FB ad = audience fredda (non sa chi sei), sales page = audience calda (ha gia' visto opt-in ed email sequence). Copy identico per entrambe = conversione zero.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:05:30",
   "frame": "frame-200",
   "confidenza": "",
   "tags": [
    "briefing",
