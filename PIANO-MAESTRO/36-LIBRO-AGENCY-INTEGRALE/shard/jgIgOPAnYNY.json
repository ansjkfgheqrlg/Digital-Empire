  {
   "uid": "jgIgOPAnYNY::KA-11",
   "ka_id": "KA-11",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Metodo di ricerca",
   "contenuto": "Metodo pratico di ricerca: YouTube -> cerca video recensioni del prodotto/categoria -> estrai pain point e desideri espliciti del target. Esempio candele profumate: reviewer dice 'non dura tantissimo' -> insight: il target vuole durabilita' -> va nel copy. Metodo replicabile per qualsiasi nicchia.",
   "ancora": "",
   "fonte": "jgIgOPAnYNY#0:11:00",
   "frame": "",
   "confidenza": "",
   "tags": [
    "ricerca",
    "voice-of-customer",
    "metodo"
   ],
   "relazioni": [],
