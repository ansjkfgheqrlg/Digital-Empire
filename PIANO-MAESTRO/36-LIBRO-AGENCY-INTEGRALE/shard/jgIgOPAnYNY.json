  {
   "uid": "jgIgOPAnYNY::KA-03",
   "ka_id": "KA-03",
   "run": "jgIgOPAnYNY",
   "tipo": "Copywriting / Briefing",
   "contenuto": "'Prodotto' nel briefing significa 'cosa stiamo vendendo' - include idee, personalita', video, servizi, non solo oggetti fisici. Estende il concetto di prodotto a qualsiasi offerta digitale/personale.",
