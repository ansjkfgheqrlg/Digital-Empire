{
  "version": "2.0.0",
  "description": "Pattern per il riconoscimento di meta-statement — dichiarazioni che riguardano altre skill o l'intero sistema di skill, non il comportamento operativo.",
  "meta_patterns": [
    {
      "id": "overrides_all",
      "category": "global_invalidation",
      "patterns": [
        "questa skill sovrascrive tutte le altre",
        "questa skill ha precedenza su ogni altra",
        "prevale su qualsiasi altra skill",
        "ignora tutte le altre regole",
        "this skill overrides all others",
        "this skill takes precedence over all",
        "overrides any other skill",
        "ignore all other rules"
      ],
      "effect": "invalida tutte le skill coesistenti"
    },
    {
      "id": "overrides_domain",
      "category": "domain_invalidation",
      "patterns": [
        "ignora qualsiasi regola (?:sulla|sul|sullo|sugli|sulle) (\\w+)",
        "sovrascrive le regole di (\\w+)",
        "ha precedenza in materia di (\\w+)",
        "ignore any rules? (?:about|on|regarding) (\\w+)",
        "overrides rules? (?:about|on|regarding) (\\w+)"
      ],
      "effect": "invalida regole di altre skill in un dominio specifico"
    },
    {
      "id": "always_prefer_this",
      "category": "preference_statement",
      "patterns": [
        "preferisci sempre (?:questa|le regole di questa)",
        "in caso di conflitto, scegli questa",
        "always prefer this",
        "in case of conflict, choose this",
        "when in doubt, follow this skill"
      ],
      "effect": "dichiara preferenza assoluta in caso di conflitto"
    },
    {
      "id": "this_is_supreme",
      "category": "supremacy_claim",
      "patterns": [
        "questa regola è suprema",
        "questa direttiva è assoluta",
        "non può essere sovrascritta",
        "this rule is supreme",
        "this directive is absolute",
        "cannot be overridden",
        "takes ultimate priority"
      ],
      "effect": "rivendica autorità suprema"
    }
  ]
}

