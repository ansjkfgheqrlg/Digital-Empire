{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/agent.schema.json",
  "title": "Agent target output structure (v0.3 — Phase 9 tightened)",
  "description": "Forma canonica dell'output del agent-builder + Stage 7 depth pass. Validata da C3 con check bloccanti.",
  "type": "object",
  "schema_version": "0.3.0",
  "version_history": {
    "0.1.0-draft": "Phase 1 scaffold",
    "0.2.0-draft": "Phase 2 properties populated",
    "0.3.0": "Phase 9 tightened — minimi forzanti per evitare output magri"
  },
  "required": [
    "required_files",
    "agent_md_min_words",
    "system_prompt_min_words",
    "system_prompt_max_words",
    "playbook_min_conversations",
    "failure_modes_min_count",
    "eval_cases_min",
    "eval_cases_max"
  ],
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "agent.md",
        "system_prompt.md",
        "tools.md",
        "playbook.md",
        "failure_modes.md",
        "eval_cases.json",
        "README.md"
      ],
      "description": "Tutti e 7 obbligatori. Verificato da C3."
    },
    "agent_md_required_sections": {
      "type": "array",
      "const": [
        "Identità e ruolo",
        "Obiettivi",
        "Utente target",
        "Comportamento atteso",
        "Vincoli",
        "Strumenti",
        "Tono e stile",
        "Failure modes principali",
        "Metriche di successo"
      ]
    },
    "agent_md_min_words": {
      "const": 400,
      "description": "agent.md sotto soglia = scaffold inaccettabile"
    },
    "system_prompt_min_words": {
      "const": 500,
      "description": "SP troppo magro = agente generic"
    },
    "system_prompt_max_words": {
      "const": 1500,
      "description": "SP troppo lungo = lost-in-the-middle"
    },
    "playbook_min_conversations": {
      "const": 5,
      "description": "Mix happy/edge/failure"
    },
    "playbook_conversation_categories_required": {
      "type": "array",
      "const": [
        "happy",
        "edge",
        "failure_recovery"
      ],
      "description": "Almeno 1 conversazione per categoria"
    },
    "failure_modes_min_count": {
      "const": 7,
      "description": "Tabella con almeno 7 failure"
    },
    "failure_modes_required_columns": {
      "type": "array",
      "const": [
        "ID",
        "Failure",
        "Sintomo",
        "Prevenzione",
        "Rilevamento",
        "Recupero"
      ]
    },
    "eval_cases_min": {
      "const": 8
    },
    "eval_cases_max": {
      "const": 15
    },
    "eval_cases_distribution_target": {
      "type": "object",
      "const": {
        "happy": 0.4,
        "edge": 0.3,
        "failure": 0.2,
        "constraint": 0.1
      }
    },
    "tools_md_min_per_tool_fields": {
      "type": "array",
      "const": [
        "description",
        "when_to_use",
        "input_schema",
        "output_schema",
        "errors_possible",
        "example_invocation"
      ]
    }
  },
  "additionalProperties": false
}