{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/team.schema.json",
  "title": "Team target output structure (v0.3 — Phase 9 tightened)",
  "type": "object",
  "schema_version": "0.3.0",
  "required": [
    "required_files",
    "agents_min_count",
    "agents_min_files_each"
  ],
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "topology.md",
        "communication_protocol.md",
        "handoff_rules.md",
        "failure_handling.md",
        "shared_state.md",
        "team_eval_cases.json",
        "README.md"
      ]
    },
    "conditional_files": {
      "type": "object",
      "properties": {
        "coordinator.md": {
          "type": "string",
          "const": "required if topology in [supervisor, hub-spoke]"
        }
      }
    },
    "required_directories": {
      "type": "array",
      "const": [
        "agents"
      ]
    },
    "topologies_allowed": {
      "type": "array",
      "const": [
        "supervisor",
        "pipeline",
        "peer-to-peer",
        "hub-spoke",
        "hybrid"
      ]
    },
    "raci_strict": {
      "type": "boolean",
      "const": true
    },
    "agents_min_count": {
      "const": 2,
      "description": "Team con 1 agente è un agent singolo"
    },
    "agents_min_files_each": {
      "const": 5,
      "description": "FIX Phase 9: ogni agente del team deve avere ≥5/7 file canonici (vedi agent.schema)"
    },
    "topology_md_required": {
      "const": true
    },
    "handoff_rules_required": {
      "const": true
    },
    "failure_handling_min_modes": {
      "const": 5
    },
    "team_eval_cases_min": {
      "const": 3,
      "description": "Almeno 3 scenari end-to-end"
    }
  },
  "additionalProperties": false
}