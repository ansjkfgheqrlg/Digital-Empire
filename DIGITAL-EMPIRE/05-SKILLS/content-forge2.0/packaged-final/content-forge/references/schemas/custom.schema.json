{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/custom.schema.json",
  "title": "Custom target output structure",
  "type": "object",
  "schema_version": "0.2.0-draft",
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "spec.md",
        "coverage_map.md",
        "README.md"
      ]
    },
    "required_directories": {
      "type": "array",
      "const": [
        "artifact"
      ]
    },
    "spec_md_required_sections": {
      "type": "array",
      "const": [
        "Original Request",
        "Chosen Form",
        "Constraints Applied",
        "Injection Target",
        "Trade-offs",
        "How to Verify"
      ]
    },
    "coverage_map_required_fields_per_atom": {
      "type": "array",
      "const": [
        "atom_id",
        "atom_title",
        "status",
        "location_in_artifact",
        "rationale"
      ]
    },
    "valid_status_values": {
      "type": "array",
      "const": [
        "included",
        "out_of_scope"
      ]
    }
  }
}