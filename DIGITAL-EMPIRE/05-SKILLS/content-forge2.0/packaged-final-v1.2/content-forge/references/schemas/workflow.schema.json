{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-forge/schemas/workflow.schema.json",
  "title": "Workflow target output structure (v0.3 — Phase 9 tightened)",
  "type": "object",
  "schema_version": "0.3.0",
  "required": [
    "required_files",
    "required_directories",
    "dag_must_be_acyclic"
  ],
  "properties": {
    "required_files": {
      "type": "array",
      "const": [
        "flow.md",
        "flow.mermaid",
        "state.md",
        "triggers.md",
        "error_handling.md",
        "observability.md",
        "runbook.md",
        "eval_scenarios.json",
        "README.md"
      ]
    },
    "required_directories": {
      "type": "array",
      "const": [
        "steps"
      ]
    },
    "dag_must_be_acyclic": {
      "const": true
    },
    "state_schema_strict": {
      "const": true
    },
    "step_types_allowed": {
      "type": "array",
      "const": [
        "agent",
        "skill",
        "script",
        "manual",
        "branch",
        "merge",
        "parallel"
      ]
    },
    "steps_min_count": {
      "const": 3,
      "description": "Workflow con <3 step è procedura semplice"
    },
    "agent_steps_must_link_valid_agent": {
      "const": true,
      "description": "FIX Phase 9: ogni step type=agent deve linkare ad agent valido (agent.schema)"
    },
    "skill_steps_must_link_valid_skill": {
      "const": true,
      "description": "FIX Phase 9: ogni step type=skill deve linkare a skill valida (skill.schema)"
    },
    "runbook_min_scenarios": {
      "const": 5,
      "description": "Runbook utile ha ≥5 scenari operativi"
    },
    "error_handling_min_failures": {
      "const": 8,
      "description": "Failure mode coverage minima"
    }
  },
  "additionalProperties": false
}